+export const generateWavefrontObj = (
+  documentName: string,
+  report: CadGeometryReport,
+): { readonly objText: string; readonly vertexCount: number; readonly triangleCount: number } => {
+  const safeDoc = documentName.replace(/[^A-Za-z0-9_-]+/g, "_") || "t3cad_part";
+  const lines: string[] = [`# T3CAD Wavefront OBJ Export (${safeDoc})`, "# Units: millimeters"];
+  let vertexOffset = 1;
+  let vertexCount = 0;
+  let triangleCount = 0;
+
+  for (const body of report.bodies) {
+    const objectName = body.featureId.replace(/[^A-Za-z0-9_-]+/g, "_") || "body";
+    lines.push(`o ${objectName}`);
+    const { positions, normals, indices } = body;
+    const bodyVertexCount = Math.floor(positions.length / 3);
+    for (let i = 0; i < bodyVertexCount; i++) {
+      const base = i * 3;
+      lines.push(`v ${positions[base]} ${positions[base + 1]} ${positions[base + 2]}`);
+      lines.push(`vn ${normals[base] ?? 0} ${normals[base + 1] ?? 0} ${normals[base + 2] ?? 1}`);
+    }
+    for (let i = 0; i < indices.length; i += 3) {
+      const a = vertexOffset + indices[i]!;
+      const b = vertexOffset + indices[i + 1]!;
+      const c = vertexOffset + indices[i + 2]!;
+      lines.push(`f ${a}//${a} ${b}//${b} ${c}//${c}`);
+      triangleCount += 1;
+    }
+    vertexOffset += bodyVertexCount;
+    vertexCount += bodyVertexCount;
+  }
+
+  return { objText: `${lines.join("\n")}\n`, vertexCount, triangleCount };
+};
