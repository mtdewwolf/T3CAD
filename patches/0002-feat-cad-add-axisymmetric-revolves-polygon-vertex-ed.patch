+
+it.effect(
+  "supports stepped_flange revolve preset, polygon vertex editing, revolve guards, and OBJ export",
+  () =>
+    Effect.scoped(
+      Effect.gen(function* () {
+        const fs = yield* FileSystem.FileSystem;
+        const path = yield* Path.Path;
+        const workspaceRoot = yield* fs.makeTempDirectoryScoped({ prefix: "t3cad-wave2-" });
+        const serviceLayer = makeTestLayer(workspaceRoot);
+
+        yield* Effect.gen(function* () {
+          const cad = yield* CadDocumentService.CadDocumentService;
+          const docId = CadDocumentId.make("turned_flange");
+
+          const created = yield* cad.createDocument({
+            projectId: PROJECT_ID,
+            documentId: docId,
+            name: "Turned Stepped Flange",
+            preset: "stepped_flange",
+          });
+
+          assert.equal(created.revision, 1);
+          assert.equal(created.features.length, 10);
+          assert.equal(created.report.status, "valid");
+          assert.equal(created.report.watertight, true);
+          assert.deepEqual(created.report.boundsMm, {
+            min: [-42, -42, 0],
+            max: [42, 42, 28],
+          });
+          assert.isTrue(created.report.totalVolumeMm3 > 67_500);
+          assert.isTrue(created.report.totalVolumeMm3 < 69_000);
+
+          // Reject polygon point update that would cross dependent revolve's rotation axis.
+          const axisCrossExit = yield* Effect.exit(
+            cad.applyCommands({
+              projectId: PROJECT_ID,
+              documentId: docId,
+              requestId: CadRequestId.make("req-poly-cross"),
+              expectedRevision: NonNegativeInt.make(1),
+              actor: { kind: "user", id: "designer" },
+              commands: [
+                {
+                  op: "sketch.set_polygon_points",
+                  featureId: CadFeatureId.make("flange_profile"),
+                  points: [
+                    [-5, 0],
+                    [42, 0],
+                    [42, 10],
+                    [12, 10],
+                  ],
+                },
+              ],
+            }),
+          );
+          assert.equal(axisCrossExit._tag, "Failure");
+
+          // Valid polygon expansion + partial 180° revolve edit.
+          const updated = yield* cad.applyCommands({
+            projectId: PROJECT_ID,
+            documentId: docId,
+            requestId: CadRequestId.make("req-flange-edit"),
+            expectedRevision: NonNegativeInt.make(1),
+            actor: { kind: "agent", id: "cad-agent", label: "T3CAD Agent" },
+            commands: [
+              {
+                op: "sketch.set_polygon_points",
+                featureId: CadFeatureId.make("flange_profile"),
+                points: [
+                  [12, 0],
+                  [48, 0],
+                  [48, 10],
+                  [22, 10],
+                  [22, 28],
+                  [12, 28],
+                ],
+              },
+              {
+                op: "feature.set_parameter",
+                featureId: CadFeatureId.make("flange_body"),
+                parameter: "angleDeg",
+                value: 180,
+              },
+            ],
+          });
+          assert.equal(updated.revision, 2);
+          assert.equal(updated.snapshot.report.watertight, true);
+          assert.deepEqual(updated.snapshot.report.boundsMm, {
+            min: [-48, 0, 0],
+            max: [48, 48, 28],
+          });
+
+          const obj = yield* cad.exportObj({
+            projectId: PROJECT_ID,
+            documentId: docId,
+            relativePath: "exports/turned_flange.obj",
+          });
+          assert.equal(obj.writtenPath, "exports/turned_flange.obj");
+          assert.isTrue(obj.vertexCount > 300);
+          assert.isTrue(obj.triangleCount > 100);
+          assert.isTrue(obj.objText.includes("o flange_body\n"));
+          assert.isTrue(yield* fs.exists(path.join(workspaceRoot, "exports/turned_flange.obj")));
+
+          const escapeObj = yield* Effect.exit(
+            cad.exportObj({
+              projectId: PROJECT_ID,
+              documentId: docId,
+              relativePath: "../escape.obj",
+            }),
+          );
+          assert.equal(escapeObj._tag, "Failure");
+        }).pipe(Effect.provide(serviceLayer));
+      }),
+    ).pipe(Effect.provide(NodeServices.layer)),
+);
