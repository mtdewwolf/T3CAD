+const validateDependentRevolves = (features: ReadonlyArray<CadFeature>): CadFeatureError | null => {
+  for (const feature of features) {
+    if (feature.kind !== "revolve") continue;
+    const profile = features.find((candidate) => candidate.id === feature.profileId);
+    if (!profile || profile.kind === "extrusion" || profile.kind === "revolve") continue;
+    if (revolveProfileCrossesAxis(profile, feature.axis, feature.axisOffset)) {
+      return new CadFeatureError({
+        code: "geometry_invalid",
+        detail: `Revolve '${feature.id}' profile '${feature.profileId}' crosses or lies on the rotation axis.`,
+      });
+    }
+  }
+  return null;
+};
