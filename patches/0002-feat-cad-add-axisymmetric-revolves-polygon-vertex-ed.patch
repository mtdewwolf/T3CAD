diff --git a/apps/web/src/components/cad/CadSketchBlueprint.tsx b/apps/web/src/components/cad/CadSketchBlueprint.tsx
new file mode 100644
index 00000000..1093d393
--- /dev/null
+++ b/apps/web/src/components/cad/CadSketchBlueprint.tsx
@@ -0,0 +1,242 @@
+import type { CadFeature, CadRevolveFeature, CadSketchPlane } from "@t3tools/contracts";
+
+type SketchFeature = Extract<CadFeature, { kind: "rectangle" | "circle" | "polygon" }>;
+
+interface CadSketchBlueprintProps {
+  readonly sketch: SketchFeature;
+  readonly draftValues?: Readonly<Record<string, string>>;
+  readonly draftPoints?: ReadonlyArray<readonly [string, string]>;
+  readonly dependentRevolve?: CadRevolveFeature | undefined;
+}
+
+const PLANE_AXIS_LABELS: Record<CadSketchPlane, readonly [string, string]> = {
+  xy: ["X", "Y"],
+  xz: ["X", "Z"],
+  yz: ["Y", "Z"],
+};
+
+function numOrFallback(raw: string | undefined, fallback: number): number {
+  if (raw === undefined || raw.trim() === "") return fallback;
+  const n = Number(raw);
+  return Number.isFinite(n) ? n : fallback;
+}
+
+export function CadSketchBlueprint({
+  sketch,
+  draftValues,
+  draftPoints,
+  dependentRevolve,
+}: CadSketchBlueprintProps) {
+  const plane: CadSketchPlane = sketch.plane ?? "xy";
+  const [uLabel, vLabel] = PLANE_AXIS_LABELS[plane];
+
+  let minU = 0;
+  let maxU = 0;
+  let minV = 0;
+  let maxV = 0;
+
+  let rectSpec: { x: number; y: number; width: number; height: number } | null = null;
+  let circleSpec: { cx: number; cy: number; radius: number } | null = null;
+  let polyNodes: Array<{
+    readonly key: string;
+    readonly label: string;
+    readonly u: number;
+    readonly v: number;
+  }> | null = null;
+
+  if (sketch.kind === "rectangle") {
+    const x = numOrFallback(draftValues?.x, sketch.x);
+    const y = numOrFallback(draftValues?.y, sketch.y);
+    const width = Math.max(0.01, numOrFallback(draftValues?.width, sketch.width));
+    const height = Math.max(0.01, numOrFallback(draftValues?.height, sketch.height));
+    rectSpec = { x, y, width, height };
+    minU = Math.min(0, x, x + width);
+    maxU = Math.max(0, x, x + width);
+    minV = Math.min(0, y, y + height);
+    maxV = Math.max(0, y, y + height);
+  } else if (sketch.kind === "circle") {
+    const cx = numOrFallback(draftValues?.cx, sketch.cx);
+    const cy = numOrFallback(draftValues?.cy, sketch.cy);
+    const radius = Math.max(0.01, numOrFallback(draftValues?.radius, sketch.radius));
+    circleSpec = { cx, cy, radius };
+    minU = Math.min(0, cx - radius);
+    maxU = Math.max(0, cx + radius);
+    minV = Math.min(0, cy - radius);
+    maxV = Math.max(0, cy + radius);
+  } else {
+    const seen = new Map<string, number>();
+    const rawList = draftPoints ?? sketch.points.map(([u, v]) => [String(u), String(v)] as const);
+    polyNodes = [];
+    for (let i = 0; i < rawList.length; i += 1) {
+      const pair = rawList[i]!;
+      const fb = sketch.points[i] ?? [0, 0];
+      const u = numOrFallback(pair[0], fb[0]);
+      const v = numOrFallback(pair[1], fb[1]);
+      const coordKey = `${u},${v}`;
+      const occ = (seen.get(coordKey) ?? 0) + 1;
+      seen.set(coordKey, occ);
+      polyNodes.push({ key: `${coordKey}#${occ}`, label: String(i), u, v });
+      if (u < minU) minU = u;
+      if (u > maxU) maxU = u;
+      if (v < minV) minV = v;
+      if (v > maxV) maxV = v;
+    }
+  }
+
+  if (dependentRevolve) {
+    if (dependentRevolve.axis === "v") {
+      minU = Math.min(minU, dependentRevolve.axisOffset);
+      maxU = Math.max(maxU, dependentRevolve.axisOffset);
+    } else {
+      minV = Math.min(minV, dependentRevolve.axisOffset);
+      maxV = Math.max(maxV, dependentRevolve.axisOffset);
+    }
+  }
+
+  const span = Math.max(maxU - minU, maxV - minV, 10);
+  const pad = span * 0.2;
+  const cx = (minU + maxU) * 0.5;
+  const cy = (minV + maxV) * 0.5;
+  const half = span * 0.5 + pad;
+  const vbMinU = cx - half;
+  const vbMaxU = cx + half;
+  const vbMinV = cy - half;
+  const vbMaxV = cy + half;
+  const width = vbMaxU - vbMinU;
+  const height = vbMaxV - vbMinV;
+
+  // Map engineering (u, +v up) -> SVG (u, -v down)
+  const toSvgY = (v: number) => -v;
+  const strokeUnit = width / 160;
+
+  return (
+    <div
+      className="overflow-hidden rounded-md border border-border/70 bg-muted/25 p-2"
+      data-cad-blueprint
+    >
+      <div className="mb-1 flex items-center justify-between font-mono text-3xs text-muted-foreground">
+        <span>
+          2D BLUEPRINT · {plane.toUpperCase()} ({uLabel}/{vLabel})
+        </span>
+        {dependentRevolve ? (
+          <span className="text-warning">
+            Revolve axis {dependentRevolve.axis.toUpperCase()}={dependentRevolve.axisOffset} mm (
+            {dependentRevolve.angleDeg}°)
+          </span>
+        ) : (
+          <span>Origin (0, 0)</span>
+        )}
+      </div>
+      <svg
+        viewBox={`${vbMinU} ${-vbMaxV} ${width} ${height}`}
+        className="h-32 w-full rounded bg-background/80"
+        role="img"
+        aria-label={`2D ${plane.toUpperCase()} sketch blueprint`}
+      >
+        {/* Origin crosshairs */}
+        <g className="text-muted-foreground/45">
+          <line
+            x1={vbMinU}
+            y1={0}
+            x2={vbMaxU}
+            y2={0}
+            stroke="currentColor"
+            strokeWidth={strokeUnit * 0.8}
+            strokeDasharray={`${strokeUnit * 3} ${strokeUnit * 3}`}
+          />
+          <line
+            x1={0}
+            y1={-vbMaxV}
+            x2={0}
+            y2={-vbMinV}
+            stroke="currentColor"
+            strokeWidth={strokeUnit * 0.8}
+            strokeDasharray={`${strokeUnit * 3} ${strokeUnit * 3}`}
+          />
+        </g>
+
+        {/* Revolve axis overlay */}
+        {dependentRevolve ? (
+          <g className="text-warning">
+            {dependentRevolve.axis === "v" ? (
+              <line
+                x1={dependentRevolve.axisOffset}
+                y1={-vbMaxV}
+                x2={dependentRevolve.axisOffset}
+                y2={-vbMinV}
+                stroke="currentColor"
+                strokeWidth={strokeUnit * 1.4}
+                strokeDasharray={`${strokeUnit * 4} ${strokeUnit * 2}`}
+              />
+            ) : (
+              <line
+                x1={vbMinU}
+                y1={toSvgY(dependentRevolve.axisOffset)}
+                x2={vbMaxU}
+                y2={toSvgY(dependentRevolve.axisOffset)}
+                stroke="currentColor"
+                strokeWidth={strokeUnit * 1.4}
+                strokeDasharray={`${strokeUnit * 4} ${strokeUnit * 2}`}
+              />
+            )}
+          </g>
+        ) : null}
+
+        {/* Shape geometry */}
+        {rectSpec ? (
+          <rect
+            x={rectSpec.x}
+            y={toSvgY(rectSpec.y + rectSpec.height)}
+            width={rectSpec.width}
+            height={rectSpec.height}
+            className="text-info"
+            fill="currentColor"
+            fillOpacity={0.2}
+            stroke="currentColor"
+            strokeWidth={strokeUnit * 1.5}
+          />
+        ) : null}
+
+        {circleSpec ? (
+          <circle
+            cx={circleSpec.cx}
+            cy={toSvgY(circleSpec.cy)}
+            r={circleSpec.radius}
+            className="text-success"
+            fill="currentColor"
+            fillOpacity={0.2}
+            stroke="currentColor"
+            strokeWidth={strokeUnit * 1.5}
+          />
+        ) : null}
+
+        {polyNodes ? (
+          <g className="text-info">
+            <polygon
+              points={polyNodes.map((node) => `${node.u},${toSvgY(node.v)}`).join(" ")}
+              fill="currentColor"
+              fillOpacity={0.2}
+              stroke="currentColor"
+              strokeWidth={strokeUnit * 1.5}
+            />
+            {polyNodes.map((node) => (
+              <g key={node.key} className="text-foreground">
+                <circle cx={node.u} cy={toSvgY(node.v)} r={strokeUnit * 2.2} fill="currentColor" />
+                <text
+                  x={node.u + strokeUnit * 2.6}
+                  y={toSvgY(node.v) - strokeUnit * 1.5}
+                  fontSize={strokeUnit * 7}
+                  fill="currentColor"
+                  fillOpacity={0.8}
+                  fontFamily="monospace"
+                >
+                  {node.label}
+                </text>
+              </g>
+            ))}
+          </g>
+        ) : null}
+      </svg>
+    </div>
+  );
+}
