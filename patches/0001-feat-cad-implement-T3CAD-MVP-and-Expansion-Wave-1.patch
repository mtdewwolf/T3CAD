+    existingIds.has(CadFeatureId.make(`${prefixA}_${suffix}`)) ||
+    existingIds.has(CadFeatureId.make(`${prefixB}_${suffix}`))
+  ) {
+    suffix += 1;
+  }
+  return suffix;
+}
+
+export function CadWorkspacePanel(props: CadWorkspacePanelProps) {
