+import * as McpInvocationContext from "../../McpInvocationContext.ts";
+import * as McpToolAccessTestkit from "../../McpToolAccess.testkit.ts";
+
+const PROJECT_ID = ProjectId.make("project:mcp-test");
+const THREAD_ID = ThreadId.make("cad-agent-thread");
+
+const scope: McpInvocationContext.McpInvocationScope = {
+  environmentId: EnvironmentId.make("env-cad"),
+  requestNamespace: "cad-agent-session",
+  thread: {
+    threadId: THREAD_ID,
+    providerSessionId: "cad-agent-session",
+    providerInstanceId: ProviderInstanceId.make("codex"),
+  },
+  client: undefined,
+  issuedAt: 0,
+  capabilities: new Set(["orchestration"]),
+};
+
+const mcpClient = McpSchema.McpServerClient.of({
+  clientId: 1,
+  protocolVersion: "2025-06-18",
+  clientCapabilities: {},
+  clientInfo: { name: "cad-agent-test", version: "1" },
+  initializePayload: {
+    protocolVersion: "2025-06-18",
+    capabilities: {},
+    clientInfo: { name: "cad-agent-test", version: "1" },
+  },
+  getClient: Effect.die("unused"),
+});
+
+it.effect("executes full CAD workflow through MCP tools with thread project resolution", () =>
+  Effect.scoped(
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const path = yield* Path.Path;
+      const workspaceRoot = yield* fs.makeTempDirectoryScoped({ prefix: "t3cad-mcp-" });
+
+      const projectServiceStub = Layer.mock(ProjectService.ProjectService)({
+        getById: (projectId) => {
+          const project: Project = {
+            id: PROJECT_ID,
+            title: "CAD MCP Project",
+            workspaceRoot,
+            defaultModelSelection: null,
+            scripts: [],
+            createdAt: IsoDateTime.make("2026-01-01T00:00:00.000Z"),
+            updatedAt: IsoDateTime.make("2026-01-01T00:00:00.000Z"),
+            deletedAt: null,
+          };
+          return projectId === PROJECT_ID ? Effect.succeedSome(project) : Effect.succeedNone;
+        },
+      });
+
+      const testLayer = McpHttpServer.layerCadToolkit.pipe(
+        Layer.provideMerge(McpHttpServer.layerInProcessMcpServer),
+        Layer.provide(
+          CadDocumentService.layer.pipe(
+            Layer.provideMerge(projectServiceStub),
+            Layer.provideMerge(WorkspacePaths.layer),
+          ),
+        ),
+        Layer.provide(McpToolAccessTestkit.liveThreadsLayer),
+        Layer.provide(NodeCrypto.layer),
+        Layer.provide(NodeServices.layer),
+      );
+
+      yield* Effect.gen(function* () {
+        const server = yield* McpServer.McpServer;
+        const callTool = (name: string, args: Record<string, unknown>) =>
+          server
+            .callTool({ name, arguments: args })
+            .pipe(
+              Effect.provideService(McpInvocationContext.McpInvocationContext, scope),
+              Effect.provideService(McpSchema.McpServerClient, mcpClient),
+            );
+
+        const caps = yield* callTool("cad_capabilities", {});
+        expect(caps.isError).toBe(false);
+        expect(caps.structuredContent).toMatchObject({
+          protocolVersion: 1,
+          units: "mm",
+          kernel: "t3cad-csg-kernel",
+          sketchPlanes: ["xy", "xz", "yz"],
+          extrusionOperations: ["new_body", "union", "cut", "intersect"],
+          presets: ["blank", "mounting_plate", "l_bracket"],
+          revisionRestore: true,
+          stlExport: true,
+        });
+
+        const created = yield* callTool("cad_create_document", {
+          documentId: "flange_v1",
+          name: "Servo Flange",
+          preset: "mounting_plate",
+        });
+        expect(created.isError).toBe(false);
+        const createdSnapshot = created.structuredContent as {
+          revision: number;
+          report: {
+            status: string;
+            watertight: boolean;
+            bodies: Array<Record<string, unknown>>;
+          };
+        };
+        expect(createdSnapshot.revision).toBe(1);
+        expect(createdSnapshot.report.status).toBe("valid");
+        expect(createdSnapshot.report.watertight).toBe(true);
+        expect(createdSnapshot.report.bodies[0]).not.toHaveProperty("positions");
+
+        const applied = yield* callTool("cad_apply", {
+          documentId: "flange_v1",
+          requestId: "agent-resize-1",
+          expectedRevision: 1,
+          commands: [
+            {
+              op: "feature.set_parameter",
+              featureId: "plate_body",
+              parameter: "depth",
+              value: 12,
+            },
+          ],
+        });
+        expect(applied.isError).toBe(false);
+        expect(applied.structuredContent).toMatchObject({
+          revision: 2,
+          replayed: false,
+          snapshot: {
+            report: {
+              boundsMm: { min: [0, 0, 0], max: [100, 60, 12] },
+            },
+          },
+        });
+
+        const restored = yield* callTool("cad_restore_revision", {
+          documentId: "flange_v1",
+          requestId: "agent-restore-1",
+          expectedRevision: 2,
+          targetRevision: 1,
+        });
+        expect(restored.isError).toBe(false);
+        expect(restored.structuredContent).toMatchObject({
+          revision: 3,
+          replayed: false,
+          snapshot: {
+            report: {
+              boundsMm: { min: [0, 0, 0], max: [100, 60, 8] },
+            },
+          },
+        });
+
+        const bracket = yield* callTool("cad_create_document", {
+          documentId: "bracket_mcp",
+          name: "MCP Bracket",
+          preset: "l_bracket",
+        });
+        expect(bracket.isError).toBe(false);
+        expect(bracket.structuredContent).toMatchObject({
+          revision: 1,
+          report: {
+            status: "valid",
+            watertight: true,
+            boundsMm: { min: [0, 0, 0], max: [80, 50, 60] },
+          },
+        });
+
+        const exported = yield* callTool("cad_export_stl", {
+          documentId: "flange_v1",
+        });
+        expect(exported.isError).toBe(false);
+        expect(exported.structuredContent).toMatchObject({
+          documentId: "flange_v1",
+          revision: 3,
+          writtenPath: "exports/flange_v1.stl",
+        });
+        expect(yield* fs.exists(path.join(workspaceRoot, "exports/flange_v1.stl"))).toBe(true);
+
+        const listed = yield* callTool("cad_list_documents", {});
+        expect(listed.isError).toBe(false);
+        expect(listed.structuredContent).toMatchObject({
+          projectId: PROJECT_ID,
+          documents: expect.arrayContaining([
+            expect.objectContaining({ documentId: "flange_v1", revision: 3 }),
+            expect.objectContaining({ documentId: "bracket_mcp", revision: 1 }),
+          ]),
+        });
+      }).pipe(Effect.provide(testLayer));
+    }),
+  ).pipe(Effect.provide(NodeServices.layer)),
+);
