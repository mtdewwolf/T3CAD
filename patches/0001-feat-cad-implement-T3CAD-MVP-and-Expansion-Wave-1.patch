+++ b/apps/server/src/mcp/toolkits/cad/handlers.ts
@@ -0,0 +1,183 @@
+import {
+  type CadActor,
+  type CadDocumentSnapshot,
+  type CadDomainError,
+  OrchestratorMcpFailure,
+} from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as CadDocumentService from "../../../cad/CadDocumentService.ts";
+import * as McpToolAccess from "../../McpToolAccess.ts";
+import { type Caller, loadCaller, resolveProjectId } from "../../threadAccess.ts";
+import { type CadMcpDocumentSnapshot, CadToolkit } from "./tools.ts";
+
+const summarizeSnapshot = (snapshot: CadDocumentSnapshot): CadMcpDocumentSnapshot => ({
+  schemaVersion: snapshot.schemaVersion,
+  documentId: snapshot.documentId,
+  name: snapshot.name,
+  units: snapshot.units,
+  revision: snapshot.revision,
+  updatedAt: snapshot.updatedAt,
+  features: snapshot.features,
+  report: {
+    engine: snapshot.report.engine,
+    status: snapshot.report.status,
+    watertight: snapshot.report.watertight,
+    totalVolumeMm3: snapshot.report.totalVolumeMm3,
+    totalSurfaceAreaMm2: snapshot.report.totalSurfaceAreaMm2,
+    boundsMm: snapshot.report.boundsMm,
+    bodies: snapshot.report.bodies.map((body) => ({
+      featureId: body.featureId,
+      label: body.label,
+      boundsMm: body.boundsMm,
+      volumeMm3: body.volumeMm3,
+      surfaceAreaMm2: body.surfaceAreaMm2,
+      triangleCount: body.triangleCount,
+      watertight: body.watertight,
+    })),
+    warnings: snapshot.report.warnings,
+    limitations: snapshot.report.limitations,
+  },
+  history: snapshot.history.slice(-20),
+});
+
+const mapCadDomainError = (error: CadDomainError): OrchestratorMcpFailure => {
+  switch (error._tag) {
+    case "CadStorageError":
+      return new OrchestratorMcpFailure({
+        code: "orchestration_error",
+        message: error.message,
+      });
+    default:
+      return new OrchestratorMcpFailure({
+        code: "invalid_request",
+        message: error.message,
+      });
+  }
+};
+
+const resolveActor = (context: Caller): CadActor => {
+  if (context.scope.thread !== undefined) {
+    return {
+      kind: "agent",
+      id: context.scope.thread.threadId,
+      label: `${context.scope.thread.providerInstanceId} agent`,
+    };
+  }
+  return {
+    kind: "agent",
+    id: context.scope.client?.sessionId ?? "mcp-client",
+    label: context.scope.client?.label ?? "MCP Client",
+  };
+};
+
+export const layer = McpToolAccess.toLayer(CadToolkit, {
+  cad_capabilities: McpToolAccess.reads(() =>
+    CadDocumentService.CadDocumentService.pipe(Effect.map((cad) => cad.capabilities())),
+  ),
+  cad_list_documents: McpToolAccess.reads((input) =>
+    Effect.gen(function* () {
+      const context = yield* loadCaller();
+      const projectId = yield* resolveProjectId(context, input.projectId);
+      const cad = yield* CadDocumentService.CadDocumentService;
+      return yield* cad.listDocuments({ projectId }).pipe(Effect.mapError(mapCadDomainError));
+    }),
+  ),
+  cad_create_document: McpToolAccess.writesWithCapability((input) =>
+    Effect.gen(function* () {
+      const context = yield* loadCaller();
+      const projectId = yield* resolveProjectId(context, input.projectId);
+      const cad = yield* CadDocumentService.CadDocumentService;
+      const snapshot = yield* cad
+        .createDocument({
+          projectId,
+          documentId: input.documentId,
+          ...(input.name !== undefined ? { name: input.name } : {}),
+          ...(input.preset !== undefined ? { preset: input.preset } : {}),
+          actor: resolveActor(context),
+        })
+        .pipe(Effect.mapError(mapCadDomainError));
+      return summarizeSnapshot(snapshot);
+    }),
+  ),
+  cad_inspect: McpToolAccess.reads((input) =>
+    Effect.gen(function* () {
+      const context = yield* loadCaller();
+      const projectId = yield* resolveProjectId(context, input.projectId);
+      const cad = yield* CadDocumentService.CadDocumentService;
+      const snapshot = yield* cad
+        .inspectDocument({ projectId, documentId: input.documentId })
+        .pipe(Effect.mapError(mapCadDomainError));
+      return summarizeSnapshot(snapshot);
+    }),
+  ),
+  cad_apply: McpToolAccess.writesWithCapability((input) =>
+    Effect.gen(function* () {
+      const context = yield* loadCaller();
+      const projectId = yield* resolveProjectId(context, input.projectId);
+      const cad = yield* CadDocumentService.CadDocumentService;
+      const applied = yield* cad
+        .applyCommands({
+          projectId,
+          documentId: input.documentId,
+          requestId: input.requestId,
+          expectedRevision: input.expectedRevision,
+          actor: resolveActor(context),
+          commands: input.commands,
+        })
+        .pipe(Effect.mapError(mapCadDomainError));
+      return {
+        requestId: applied.requestId,
+        documentId: applied.documentId,
+        revision: applied.revision,
+        replayed: applied.replayed,
+        snapshot: summarizeSnapshot(applied.snapshot),
+      };
+    }),
+  ),
+  cad_restore_revision: McpToolAccess.writesWithCapability((input) =>
+    Effect.gen(function* () {
+      const context = yield* loadCaller();
+      const projectId = yield* resolveProjectId(context, input.projectId);
+      const cad = yield* CadDocumentService.CadDocumentService;
+      const restored = yield* cad
+        .restoreRevision({
+          projectId,
+          documentId: input.documentId,
+          requestId: input.requestId,
+          expectedRevision: input.expectedRevision,
+          targetRevision: input.targetRevision,
+          actor: resolveActor(context),
+        })
+        .pipe(Effect.mapError(mapCadDomainError));
+      return {
+        requestId: restored.requestId,
+        documentId: restored.documentId,
+        revision: restored.revision,
+        replayed: restored.replayed,
+        snapshot: summarizeSnapshot(restored.snapshot),
+      };
+    }),
+  ),
+  cad_export_stl: McpToolAccess.writesWithCapability((input) =>
+    Effect.gen(function* () {
+      const context = yield* loadCaller();
+      const projectId = yield* resolveProjectId(context, input.projectId);
+      const cad = yield* CadDocumentService.CadDocumentService;
+      const exported = yield* cad
+        .exportStl({
+          projectId,
+          documentId: input.documentId,
+          relativePath: input.relativePath ?? `exports/${input.documentId}.stl`,
+        })
+        .pipe(Effect.mapError(mapCadDomainError));
+      return {
+        documentId: exported.documentId,
+        revision: exported.revision,
+        filename: exported.filename,
+        writtenPath: exported.writtenPath,
+        triangleCount: exported.triangleCount,
+        byteLength: exported.byteLength,
+      };
+    }),
+  ),
+});
diff --git a/apps/server/src/mcp/toolkits/cad/tools.ts b/apps/server/src/mcp/toolkits/cad/tools.ts
new file mode 100644
index 00000000..5124bd62
--- /dev/null
+++ b/apps/server/src/mcp/toolkits/cad/tools.ts
@@ -0,0 +1,199 @@
+import {
+  CAD_MAX_BATCH_COMMANDS,
+  CAD_SCHEMA_VERSION,
+  CAD_UNITS,
+  CadBoundsMm,
+  CadCapabilities,
+  CadCommand,
+  CadDocumentId,
+  CadDocumentSummary,
+  CadFeature,
+  CadFeatureId,
+  CadFeatureName,
+  CadGeometryStatus,
+  CadHistoryEntry,
+  CadRequestId,
+  IsoDateTime,
+  NonNegativeInt,
+  OrchestratorMcpFailure,
+  ProjectId,
+} from "@t3tools/contracts";
+import * as Schema from "effect/Schema";
+import { Tool, Toolkit } from "effect/ai";
+import * as CadDocumentService from "../../../cad/CadDocumentService.ts";
+import * as ThreadManagementService from "../../../orchestration-v2/ThreadManagementService.ts";
+import * as McpInvocationContext from "../../McpInvocationContext.ts";
+
+export const CadMcpBodySummary = Schema.Struct({
+  featureId: CadFeatureId,
+  label: Schema.String,
+  boundsMm: CadBoundsMm,
+  volumeMm3: Schema.Number,
+  surfaceAreaMm2: Schema.Number,
+  triangleCount: NonNegativeInt,
+  watertight: Schema.Boolean,
+});
+export type CadMcpBodySummary = typeof CadMcpBodySummary.Type;
+
+export const CadMcpGeometrySummary = Schema.Struct({
+  engine: Schema.Literal("t3cad-csg-kernel"),
+  status: CadGeometryStatus,
+  watertight: Schema.Boolean,
+  totalVolumeMm3: Schema.Number,
+  totalSurfaceAreaMm2: Schema.Number,
+  boundsMm: Schema.NullOr(CadBoundsMm),
+  bodies: Schema.Array(CadMcpBodySummary),
+  warnings: Schema.Array(Schema.String),
+  limitations: Schema.Array(Schema.String),
+});
+export type CadMcpGeometrySummary = typeof CadMcpGeometrySummary.Type;
+
+export const CadMcpDocumentSnapshot = Schema.Struct({
+  schemaVersion: Schema.Literal(CAD_SCHEMA_VERSION),
+  documentId: CadDocumentId,
+  name: CadFeatureName,
+  units: Schema.Literal(CAD_UNITS),
+  revision: NonNegativeInt,
+  updatedAt: IsoDateTime,
+  features: Schema.Array(CadFeature),
+  report: CadMcpGeometrySummary,
+  history: Schema.Array(CadHistoryEntry),
+});
+export type CadMcpDocumentSnapshot = typeof CadMcpDocumentSnapshot.Type;
+
+export const CadMcpExportStlResult = Schema.Struct({
+  documentId: CadDocumentId,
+  revision: NonNegativeInt,
+  filename: Schema.String,
+  writtenPath: Schema.NullOr(Schema.String),
+  triangleCount: NonNegativeInt,
+  byteLength: NonNegativeInt,
+});
+
+const shared = {
+  failure: OrchestratorMcpFailure,
+  failureMode: "return" as const,
+  dependencies: [
+    McpInvocationContext.McpInvocationContext,
+    ThreadManagementService.ThreadManagementService,
+    CadDocumentService.CadDocumentService,
+  ],
+};
+
+const CadCapabilitiesTool = Tool.make("cad_capabilities", {
+  ...shared,
+  description:
+    "Discover supported CAD kernel operations, feature kinds, units (mm), and concurrency/idempotency guarantees.",
+  parameters: Tool.EmptyParams,
+  success: CadCapabilities,
+})
+  .annotate(Tool.Readonly, true)
+  .annotate(Tool.Destructive, false);
+
+const CadListDocumentsTool = Tool.make("cad_list_documents", {
+  ...shared,
+  description:
+    "List CAD documents stored in the active project (.t3cad/*.t3cad.json). Omit projectId inside a thread.",
+  parameters: Schema.Struct({
+    projectId: Schema.optional(ProjectId),
+  }),
+  success: Schema.Struct({
+    projectId: ProjectId,
+    documents: Schema.Array(CadDocumentSummary),
+  }),
+})
+  .annotate(Tool.Readonly, true)
+  .annotate(Tool.Destructive, false);
+
+const CadCreateDocumentTool = Tool.make("cad_create_document", {
+  ...shared,
+  description:
+    "Create a parametric CAD document in the active project, seeded with 'mounting_plate', 'l_bracket' (multi-plane XY+XZ bracket), or 'blank'.",
+  parameters: Schema.Struct({
+    documentId: CadDocumentId,
+    name: Schema.optional(CadFeatureName),
+    preset: Schema.optional(Schema.Literals(["blank", "mounting_plate", "l_bracket"])),
+    projectId: Schema.optional(ProjectId),
+  }),
+  success: CadMcpDocumentSnapshot,
+}).annotate(Tool.Destructive, false);
+
+const CadInspectTool = Tool.make("cad_inspect", {
+  ...shared,
+  description:
+    "Inspect full parametric feature tree, exact bounding box, volume (mm^3), surface area (mm^2), watertight check, warnings, and revision history for a CAD document.",
+  parameters: Schema.Struct({
+    documentId: CadDocumentId,
+    projectId: Schema.optional(ProjectId),
+  }),
+  success: CadMcpDocumentSnapshot,
+})
+  .annotate(Tool.Readonly, true)
+  .annotate(Tool.Destructive, false);
+
+const CadApplyTool = Tool.make("cad_apply", {
+  ...shared,
+  description:
+    "Apply an atomic batch of CAD commands (create_rectangle, create_circle, create_polygon on xy/xz/yz, extrude with new_body/union/cut/intersect, set_parameter, rename, delete) with expectedRevision and requestId. Units in mm.",
+  parameters: Schema.Struct({
+    documentId: CadDocumentId,
+    requestId: CadRequestId,
+    expectedRevision: NonNegativeInt,
+    commands: Schema.Array(CadCommand).check(
+      Schema.isMinLength(1),
+      Schema.isMaxLength(CAD_MAX_BATCH_COMMANDS),
+    ),
+    projectId: Schema.optional(ProjectId),
+  }),
+  success: Schema.Struct({
+    requestId: CadRequestId,
+    documentId: CadDocumentId,
+    revision: NonNegativeInt,
+    replayed: Schema.Boolean,
+    snapshot: CadMcpDocumentSnapshot,
+  }),
+}).annotate(Tool.Destructive, true);
+
+const CadRestoreRevisionTool = Tool.make("cad_restore_revision", {
+  ...shared,
+  description:
+    "Restore a CAD document's features to a prior revision checkpoint, committing a new forward revision with optimistic concurrency and idempotency.",
+  parameters: Schema.Struct({
+    documentId: CadDocumentId,
+    requestId: CadRequestId,
+    expectedRevision: NonNegativeInt,
+    targetRevision: NonNegativeInt,
+    projectId: Schema.optional(ProjectId),
+  }),
+  success: Schema.Struct({
+    requestId: CadRequestId,
+    documentId: CadDocumentId,
+    revision: NonNegativeInt,
+    replayed: Schema.Boolean,
+    snapshot: CadMcpDocumentSnapshot,
+  }),
+}).annotate(Tool.Destructive, true);
+
+const CadExportStlTool = Tool.make("cad_export_stl", {
+  ...shared,
+  description:
+    "Export the evaluated solid geometry of a CAD document as an ASCII STL file inside the project workspace.",
+  parameters: Schema.Struct({
+    documentId: CadDocumentId,
+    relativePath: Schema.optional(Schema.String),
+    projectId: Schema.optional(ProjectId),
+  }),
+  success: CadMcpExportStlResult,
+})
+  .annotate(Tool.Readonly, false)
+  .annotate(Tool.Destructive, false);
+
+export const CadToolkit = Toolkit.make(
+  CadCapabilitiesTool,
+  CadListDocumentsTool,
+  CadCreateDocumentTool,
+  CadInspectTool,
+  CadApplyTool,
+  CadRestoreRevisionTool,
+  CadExportStlTool,
+);
