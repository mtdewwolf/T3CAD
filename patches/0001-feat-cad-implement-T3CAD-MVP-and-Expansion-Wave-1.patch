+import { assert, it } from "@effect/vitest";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import {
+  CadDocumentId,
+  CadFeatureId,
+  CadRequestId,
+  IsoDateTime,
+  NonNegativeInt,
+  type Project,
+  ProjectId,
+} from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import { describe, expect } from "vite-plus/test";
+
+import type { CadFeature } from "@t3tools/contracts";
+import { evaluateCadFeatures, generateAsciiStl } from "./CadKernel.ts";
+import * as CadDocumentService from "./CadDocumentService.ts";
+import * as ProjectService from "../project/ProjectService.ts";
+import * as WorkspacePaths from "../workspace/WorkspacePaths.ts";
+
+const fid = (value: string) => CadFeatureId.make(value);
+
+describe("CadKernel edge cases", () => {
+  it("extrudes a box with zOffset preserving bounds and volume", () => {
+    const features: CadFeature[] = [
+      { id: fid("box_sketch"), kind: "rectangle", x: 0, y: 0, width: 10, height: 10 },
+      {
+        id: fid("box_body"),
+        kind: "extrusion",
+        profileId: fid("box_sketch"),
+        depth: 10,
+        zOffset: 5,
+        operation: "new_body",
+      },
+    ];
+    const report = evaluateCadFeatures(features);
+    expect(report.status).toBe("valid");
+    expect(report.boundsMm).toEqual({ min: [0, 0, 5], max: [10, 10, 15] });
+    expect(report.totalVolumeMm3).toBeCloseTo(1000, 4);
+  });
+
+  it("handles multiple bodies and an overlapping cut; STL normals point outward", () => {
+    const features: CadFeature[] = [
+      { id: fid("base_rect"), kind: "rectangle", x: 0, y: 0, width: 10, height: 10 },
+      {
+        id: fid("base_body"),
+        kind: "extrusion",
+        profileId: fid("base_rect"),
+        depth: 10,
+        zOffset: 0,
+        operation: "new_body",
+      },
+      { id: fid("hole_rect"), kind: "rectangle", x: 2, y: 2, width: 6, height: 6 },
+      {
+        id: fid("cut_hole"),
+        kind: "extrusion",
+        profileId: fid("hole_rect"),
+        depth: 10,
+        zOffset: 0,
+        operation: "cut",
+      },
+      { id: fid("extra_rect"), kind: "rectangle", x: 20, y: 20, width: 4, height: 4 },
+      {
+        id: fid("extra_body"),
+        kind: "extrusion",
+        profileId: fid("extra_rect"),
+        depth: 4,
+        zOffset: 0,
+        operation: "new_body",
+      },
+    ];
+
+    const report = evaluateCadFeatures(features);
+    expect(report.status).toBe("valid");
+    expect(report.bodies).toHaveLength(2);
+
+    const stl = generateAsciiStl("multi", report);
+    expect(stl.triangleCount).toBeGreaterThan(0);
+
+    for (const body of report.bodies) {
+      let signedVolume6 = 0;
+      for (let i = 0; i < body.indices.length; i += 3) {
+        const i0 = body.indices[i]! * 3;
+        const i1 = body.indices[i + 1]! * 3;
+        const i2 = body.indices[i + 2]! * 3;
+        const v0: [number, number, number] = [
+          body.positions[i0]!,
+          body.positions[i0 + 1]!,
+          body.positions[i0 + 2]!,
+        ];
+        const v1: [number, number, number] = [
+          body.positions[i1]!,
+          body.positions[i1 + 1]!,
+          body.positions[i1 + 2]!,
+        ];
+        const v2: [number, number, number] = [
+          body.positions[i2]!,
+          body.positions[i2 + 1]!,
+          body.positions[i2 + 2]!,
+        ];
+        const cross = [
+          (v1[1] - v0[1]) * (v2[2] - v0[2]) - (v1[2] - v0[2]) * (v2[1] - v0[1]),
+          (v1[2] - v0[2]) * (v2[0] - v0[0]) - (v1[0] - v0[0]) * (v2[2] - v0[2]),
+          (v1[0] - v0[0]) * (v2[1] - v0[1]) - (v1[1] - v0[1]) * (v2[0] - v0[0]),
+        ];
+        const n: [number, number, number] = [
+          body.normals[i0]!,
+          body.normals[i0 + 1]!,
+          body.normals[i0 + 2]!,
+        ];
+        const dot = n[0]! * cross[0]! + n[1]! * cross[1]! + n[2]! * cross[2]!;
+        expect(dot).toBeGreaterThanOrEqual(
+          -1e-6 * (Math.abs(cross[0]!) + Math.abs(cross[1]!) + Math.abs(cross[2]!) + 1),
+        );
+        signedVolume6 +=
+          v0[0]! * (v1[1]! * v2[2]! - v1[2]! * v2[1]!) +
+          v0[1]! * (v1[2]! * v2[0]! - v1[0]! * v2[2]!) +
+          v0[2]! * (v1[0]! * v2[1]! - v1[1]! * v2[0]!);
+      }
+      const signedVolume = Math.abs(signedVolume6) / 6;
+      expect(signedVolume).toBeCloseTo(body.volumeMm3, 2);
+    }
+  });
+
+  it("throws when an extrusion references a missing profile", () => {
+    const features: CadFeature[] = [
+      {
+        id: fid("bad_body"),
+        kind: "extrusion",
+        profileId: fid("missing_profile"),
+        depth: 5,
+        zOffset: 0,
+        operation: "new_body",
+      },
+    ];
+    expect(() => evaluateCadFeatures(features)).toThrow();
+  });
+
