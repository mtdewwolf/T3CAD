new file mode 100644
index 00000000..225af3ca
--- /dev/null
+++ b/apps/web/src/components/cad/CadViewport3d.tsx
@@ -0,0 +1,435 @@
+import type { CadBoundsMm, CadMeshBody } from "@t3tools/contracts";
+import { CompassIcon, Grid3X3Icon, Maximize2Icon } from "lucide-react";
+import { useEffect, useEffectEvent, useRef, useState } from "react";
+import * as THREE from "three";
+import { OrbitControls } from "three/examples/jsm/controls/OrbitControls.js";
+
+import { Button } from "../ui/button";
+import { observeResize } from "~/lib/observeResize";
+import { cn } from "~/lib/utils";
+
+interface CadViewport3dProps {
+  readonly bodies: ReadonlyArray<CadMeshBody>;
+  readonly boundsMm: CadBoundsMm | null;
+  readonly selectedFeatureId: string | null;
+  readonly onSelectFeature?: (featureId: string) => void;
+  readonly className?: string;
+}
+
+type CameraPreset = "iso" | "top" | "front" | "side";
+
+function boundsCenterAndRadius(boundsMm: CadBoundsMm | null): {
+  center: THREE.Vector3;
+  radius: number;
+} {
+  if (boundsMm === null) {
+    return { center: new THREE.Vector3(0, 0, 0), radius: 60 };
+  }
+  const min = new THREE.Vector3(...boundsMm.min);
+  const max = new THREE.Vector3(...boundsMm.max);
+  const center = min.clone().add(max).multiplyScalar(0.5);
+  const size = max.clone().sub(min);
+  const radius = Math.max(size.length() * 0.5, 10);
+  return { center, radius };
+}
+
+function applyCameraPreset(
+  camera: THREE.PerspectiveCamera,
+  controls: OrbitControls,
+  boundsMm: CadBoundsMm | null,
+  preset: CameraPreset,
+) {
+  const { center, radius } = boundsCenterAndRadius(boundsMm);
+  const distance = Math.max(radius * 2.35, 35);
+  const offset = new THREE.Vector3();
+  switch (preset) {
+    case "iso":
+      offset.set(distance * 0.72, -distance * 0.84, distance * 0.68);
+      break;
+    case "top":
+      offset.set(0, -Math.max(distance * 0.001, 0.01), distance * 1.15);
+      break;
+    case "front":
+      offset.set(0, -distance * 1.15, 0);
+      break;
+    case "side":
+      offset.set(distance * 1.15, 0, 0);
+      break;
+  }
+  camera.up.set(0, 0, 1);
+  camera.position.copy(center).add(offset);
+  controls.target.copy(center);
+  controls.update();
+}
+
+export function CadViewport3d(props: CadViewport3dProps) {
+  const containerRef = useRef<HTMLDivElement>(null);
+  const [showEdges, setShowEdges] = useState(true);
+  const [wireframe, setWireframe] = useState(false);
+  const [webglError, setWebglError] = useState<string | null>(null);
+
+  const sceneRef = useRef<{
+    renderer: THREE.WebGLRenderer;
+    scene: THREE.Scene;
+    camera: THREE.PerspectiveCamera;
+    controls: OrbitControls;
+    modelGroup: THREE.Group;
+    gridHelper: THREE.GridHelper;
+    disposeMeshes: () => void;
+    scheduleRender: () => void;
+  } | null>(null);
+  const initialFitBoundsRef = useRef<string | null>(null);
+  const onSelectFeatureEvent = useEffectEvent((featureId: string) => {
+    props.onSelectFeature?.(featureId);
+  });
+
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- initializes and disposes imperative Three.js WebGL context tied to the viewport DOM node
+  useEffect(() => {
+    const container = containerRef.current;
+    if (!container) return;
+
+    let active = true;
+    let renderer: THREE.WebGLRenderer;
+    try {
+      renderer = new THREE.WebGLRenderer({
+        antialias: true,
+        powerPreference: "high-performance",
+      });
+    } catch (error) {
+      const message =
+        error instanceof Error ? error.message : "3D WebGL context could not be initialized.";
+      queueMicrotask(() => {
+        if (active) setWebglError(message);
+      });
+      return () => {
+        active = false;
+      };
+    }
+
+    const width = Math.max(container.clientWidth, 1);
+    const height = Math.max(container.clientHeight, 1);
+    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
+    renderer.setSize(width, height);
+    renderer.outputColorSpace = THREE.SRGBColorSpace;
+    renderer.domElement.style.display = "block";
+    renderer.domElement.style.width = "100%";
+    renderer.domElement.style.height = "100%";
+    container.appendChild(renderer.domElement);
+
+    const scene = new THREE.Scene();
+    scene.background = new THREE.Color("#0f141c");
+
+    // CAD convention: XY is sketch plane, +Z is extrusion height.
+    const camera = new THREE.PerspectiveCamera(40, width / height, 0.25, 25_000);
+    camera.up.set(0, 0, 1);
+
+    const controls = new OrbitControls(camera, renderer.domElement);
+    controls.enableDamping = true;
+    controls.dampingFactor = 0.08;
+    controls.screenSpacePanning = true;
+    controls.minDistance = 4;
+    controls.maxDistance = 12_000;
+
+    const hemiLight = new THREE.HemisphereLight(0xdbeafe, 0x1e293b, 1.1);
+    hemiLight.position.set(0, 0, 200);
+    scene.add(hemiLight);
+
+    const keyLight = new THREE.DirectionalLight(0xffffff, 1.5);
+    keyLight.position.set(160, -140, 240);
+    scene.add(keyLight);
+
+    const fillLight = new THREE.DirectionalLight(0x93c5fd, 0.75);
+    fillLight.position.set(-180, 160, 90);
+    scene.add(fillLight);
+
+    const gridHelper = new THREE.GridHelper(320, 32, 0x334155, 0x1e293b);
+    gridHelper.rotation.x = Math.PI / 2;
+    scene.add(gridHelper);
+
+    const axesHelper = new THREE.AxesHelper(28);
+    scene.add(axesHelper);
+
+    const modelGroup = new THREE.Group();
+    scene.add(modelGroup);
+
+    const disposeMeshes = () => {
+      while (modelGroup.children.length > 0) {
+        const child = modelGroup.children[0];
+        if (!child) break;
+        modelGroup.remove(child);
+        if (child instanceof THREE.Mesh || child instanceof THREE.LineSegments) {
+          child.geometry.dispose();
+          if (Array.isArray(child.material)) {
+            for (const mat of child.material) mat.dispose();
+          } else {
+            child.material.dispose();
+          }
+        }
+      }
+    };
+
+    let rafId = 0;
+    const renderFrame = () => {
+      rafId = 0;
+      if (!active || document.hidden) return;
+      const moved = controls.update();
+      renderer.render(scene, camera);
+      if (moved) {
+        scheduleRender();
+      }
+    };
+    const scheduleRender = () => {
+      if (!active || document.hidden || rafId !== 0) return;
+      rafId = window.requestAnimationFrame(renderFrame);
+    };
+
+    sceneRef.current = {
+      renderer,
+      scene,
+      camera,
+      controls,
+      modelGroup,
+      gridHelper,
+      disposeMeshes,
+      scheduleRender,
+    };
+    initialFitBoundsRef.current = null;
+    applyCameraPreset(camera, controls, null, "iso");
+    scheduleRender();
+
+    const handleControlsChange = () => {
+      scheduleRender();
+    };
+    controls.addEventListener("change", handleControlsChange);
+
+    const handleVisibilityChange = () => {
+      if (!document.hidden) {
+        scheduleRender();
+      }
+    };
+    document.addEventListener("visibilitychange", handleVisibilityChange);
+
+    const handleContextLost = (event: Event) => {
+      event.preventDefault();
+      if (rafId !== 0) {
+        window.cancelAnimationFrame(rafId);
+        rafId = 0;
+      }
+      if (active) {
+        setWebglError("3D WebGL context lost. Attempting recovery...");
+      }
+    };
+    const handleContextRestored = () => {
+      if (!active) return;
+      setWebglError(null);
+      scheduleRender();
+    };
+    renderer.domElement.addEventListener("webglcontextlost", handleContextLost);
+    renderer.domElement.addEventListener("webglcontextrestored", handleContextRestored);
+
+    let pointerDownPos: { x: number; y: number } | null = null;
+    const raycaster = new THREE.Raycaster();
+    const pointer = new THREE.Vector2();
+
+    const handlePointerDown = (event: PointerEvent) => {
+      pointerDownPos = { x: event.clientX, y: event.clientY };
+    };
+    const handlePointerUp = (event: PointerEvent) => {
+      if (!pointerDownPos) return;
+      const moved = Math.hypot(event.clientX - pointerDownPos.x, event.clientY - pointerDownPos.y);
+      pointerDownPos = null;
+      if (moved > 4) return;
+      const rect = renderer.domElement.getBoundingClientRect();
+      if (rect.width <= 0 || rect.height <= 0) return;
+      pointer.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
+      pointer.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
+      raycaster.setFromCamera(pointer, camera);
+      const meshes = modelGroup.children.filter(
+        (obj): obj is THREE.Mesh => obj instanceof THREE.Mesh,
+      );
+      const hits = raycaster.intersectObjects(meshes, false);
+      const hitFeatureId = hits[0]?.object.userData?.featureId;
+      if (typeof hitFeatureId === "string") {
+        onSelectFeatureEvent(hitFeatureId);
+      }
+    };
+
+    renderer.domElement.addEventListener("pointerdown", handlePointerDown);
+    renderer.domElement.addEventListener("pointerup", handlePointerUp);
+
+    const stopResizeObserver = observeResize(container, (entries) => {
+      const entry = entries[0];
+      if (!entry) return;
+      const nextW = Math.max(Math.floor(entry.contentRect.width), 1);
+      const nextH = Math.max(Math.floor(entry.contentRect.height), 1);
+      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
+      camera.aspect = nextW / nextH;
+      camera.updateProjectionMatrix();
+      renderer.setSize(nextW, nextH);
+      scheduleRender();
+    });
+
+    return () => {
+      active = false;
+      if (rafId !== 0) {
+        window.cancelAnimationFrame(rafId);
+      }
+      stopResizeObserver();
+      document.removeEventListener("visibilitychange", handleVisibilityChange);
+      controls.removeEventListener("change", handleControlsChange);
+      renderer.domElement.removeEventListener("webglcontextlost", handleContextLost);
+      renderer.domElement.removeEventListener("webglcontextrestored", handleContextRestored);
+      renderer.domElement.removeEventListener("pointerdown", handlePointerDown);
+      renderer.domElement.removeEventListener("pointerup", handlePointerUp);
+      disposeMeshes();
+      gridHelper.geometry.dispose();
+      if (Array.isArray(gridHelper.material)) {
+        for (const mat of gridHelper.material) mat.dispose();
+      } else {
+        gridHelper.material.dispose();
+      }
+      axesHelper.dispose();
+      scene.clear();
+      controls.dispose();
+      renderer.dispose();
+      if (renderer.domElement.parentNode === container) {
+        container.removeChild(renderer.domElement);
+      }
+      sceneRef.current = null;
+    };
+  }, []);
+
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- rebuilds GPU geometries and materials in Three.js whenever mesh bodies or display options change
+  useEffect(() => {
+    const ctx = sceneRef.current;
+    if (!ctx) return;
+
+    ctx.disposeMeshes();
+
+    for (const body of props.bodies) {
+      if (body.positions.length === 0 || body.indices.length === 0) continue;
+      const geometry = new THREE.BufferGeometry();
+      geometry.setAttribute("position", new THREE.Float32BufferAttribute(body.positions, 3));
+      if (body.normals.length === body.positions.length) {
+        geometry.setAttribute("normal", new THREE.Float32BufferAttribute(body.normals, 3));
+      } else {
+        geometry.computeVertexNormals();
+      }
+      geometry.setIndex(body.indices as number[]);
+      geometry.computeBoundingSphere();
+
+      const selected = props.selectedFeatureId === body.featureId;
+      const material = new THREE.MeshStandardMaterial({
+        color: selected ? 0x38bdf8 : body.watertight ? 0x7c98b6 : 0xf59e0b,
+        metalness: 0.25,
+        roughness: 0.45,
+        wireframe,
+        side: THREE.DoubleSide,
+      });
+
+      const mesh = new THREE.Mesh(geometry, material);
+      mesh.userData = { featureId: body.featureId };
+      ctx.modelGroup.add(mesh);
+
+      if (showEdges && !wireframe) {
+        const edgesGeo = new THREE.EdgesGeometry(geometry, 24);
+        const edgesMat = new THREE.LineBasicMaterial({
+          color: selected ? 0xe0f2fe : 0x0f172a,
+          transparent: true,
+          opacity: selected ? 0.9 : 0.55,
+        });
+        const lines = new THREE.LineSegments(edgesGeo, edgesMat);
+        ctx.modelGroup.add(lines);
+      }
+    }
+
+    const boundsSignature = JSON.stringify(props.boundsMm);
+    if (props.boundsMm !== null && initialFitBoundsRef.current === null) {
+      initialFitBoundsRef.current = boundsSignature;
+      applyCameraPreset(ctx.camera, ctx.controls, props.boundsMm, "iso");
+    } else if (props.boundsMm === null) {
+      initialFitBoundsRef.current = null;
+    }
+    ctx.scheduleRender();
+  }, [props.bodies, props.boundsMm, props.selectedFeatureId, showEdges, wireframe]);
+
+  const triggerPreset = (preset: CameraPreset) => {
+    const ctx = sceneRef.current;
+    if (!ctx) return;
+    applyCameraPreset(ctx.camera, ctx.controls, props.boundsMm, preset);
+    ctx.scheduleRender();
+  };
+
+  return (
+    <div
+      className={cn(
+        "relative flex min-h-56 w-full flex-col overflow-hidden rounded-lg border border-border bg-code",
+        props.className,
+      )}
+      data-cad-viewport
+    >
+      <div ref={containerRef} className="h-full min-h-56 w-full flex-1" />
+
+      {webglError !== null ? (
+        <div className="pointer-events-none absolute inset-0 flex flex-col items-center justify-center gap-2 bg-code/95 px-6 text-center text-xs text-muted-foreground">
+          <CompassIcon className="size-6 text-info" />
+          <p className="font-medium text-foreground">
+            3D WebGL viewport unavailable in this browser
+          </p>
+          <p className="max-w-sm text-muted-foreground">{webglError}</p>
+        </div>
+      ) : null}
+
+      {props.bodies.length === 0 && webglError === null ? (
+        <div className="pointer-events-none absolute inset-0 flex items-center justify-center">
+          <div className="rounded-md border border-border bg-popover/85 px-3 py-1.5 text-xs text-muted-foreground">
+            No solid bodies evaluated yet. Add geometry or ask the CAD agent to build a part.
+          </div>
+        </div>
+      ) : null}
+
+      <div className="absolute top-2.5 left-2.5 flex flex-wrap items-center gap-1 rounded-md border border-border bg-popover/85 p-1 backdrop-blur-sm">
+        <Button
+          size="micro"
+          variant="ghost"
+          onClick={() => triggerPreset("iso")}
+          title="Fit isometric view"
+        >
+          <Maximize2Icon className="size-3" />
+          Iso
+        </Button>
+        <Button size="micro" variant="ghost" onClick={() => triggerPreset("top")}>
+          Top
+        </Button>
+        <Button size="micro" variant="ghost" onClick={() => triggerPreset("front")}>
+          Front
+        </Button>
+        <Button size="micro" variant="ghost" onClick={() => triggerPreset("side")}>
+          Side
+        </Button>
+      </div>
+
+      <div className="absolute top-2.5 right-2.5 flex items-center gap-1 rounded-md border border-border bg-popover/85 p-1 backdrop-blur-sm">
+        <Button
+          size="micro"
+          variant={showEdges ? "secondary" : "ghost"}
+          onClick={() => setShowEdges((prev) => !prev)}
+        >
+          Edges
+        </Button>
+        <Button
+          size="micro"
+          variant={wireframe ? "secondary" : "ghost"}
+          onClick={() => setWireframe((prev) => !prev)}
+        >
+          <Grid3X3Icon className="size-3" />
+          Wire
+        </Button>
+      </div>
+
+      <div className="pointer-events-none absolute bottom-2 left-2.5 rounded bg-popover/80 px-2 py-0.5 font-mono text-3xs text-muted-foreground">
+        Drag: Orbit · Right-drag: Pan · Scroll: Zoom · Units: mm (+Z up)
+      </div>
+    </div>
+  );
+}
