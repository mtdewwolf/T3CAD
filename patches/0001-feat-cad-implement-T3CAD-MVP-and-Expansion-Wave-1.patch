+// @effect-diagnostics nodeBuiltinImport:off
+import * as NodeCrypto from "node:crypto";
+import {
+  CAD_MAX_DIMENSION_MM,
+  CAD_SCHEMA_VERSION,
+  CAD_UNITS,
+  type CadActor,
+  type CadApplyInput,
+  type CadApplyResult,
+  type CadCapabilities,
+  type CadCommand,
+  type CadCreateDocumentInput,
+  CadDocumentAlreadyExistsError,
+  type CadDocumentEvent,
+  CadDocumentId,
+  CadDocumentNotFoundError,
+  CadDocumentSnapshot,
+  type CadDocumentSummary,
+  type CadDomainError,
+  type CadExportStlInput,
+  type CadExportStlResult,
+  CadFeature,
+  CadFeatureError,
+  CadFeatureId,
+  type CadHistoryEntry,
+  type CadInspectInput,
+  CadInvalidInputError,
+  type CadListDocumentsInput,
+  type CadListDocumentsResult,
+  type CadProjectEvent,
+  CadRequestId,
+  CadRequestIdConflictError,
+  type CadRestoreRevisionInput,
+  CadRevisionConflictError,
+  CadStorageError,
+  type CadSubscribeDocumentInput,
+  type CadSubscribeProjectInput,
+  IsoDateTime,
+  NonNegativeInt,
+  PositiveInt,
+  type ProjectId,
+} from "@t3tools/contracts";
+import * as KeyedLock from "@t3tools/shared/KeyedLock";
+import * as Context from "effect/Context";
+import * as DateTime from "effect/DateTime";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Path from "effect/Path";
+import * as PubSub from "effect/PubSub";
+import * as Schema from "effect/Schema";
+import * as Stream from "effect/Stream";
+
+import * as ProjectService from "../project/ProjectService.ts";
+import * as WorkspacePaths from "../workspace/WorkspacePaths.ts";
+import { evaluateCadFeatures, generateAsciiStl, isSimplePolygon } from "./CadKernel.ts";
+
+const CAD_DIR_NAME = ".t3cad";
+const CAD_FILE_EXTENSION = ".t3cad.json";
+const MAX_HISTORY_ENTRIES = 200;
+const MAX_IDEMPOTENCY_ENTRIES = 200;
+const MAX_CHECKPOINT_ENTRIES = 50;
+const isCadFeatureError = Schema.is(CadFeatureError);
+const decodeCadDocumentIdOption = Schema.decodeOption(CadDocumentId);
+
+export const CAD_CAPABILITIES: CadCapabilities = {
+  protocolVersion: 1,
+  units: CAD_UNITS,
+  kernel: "t3cad-csg-kernel",
+  operations: [
+    "sketch.create_rectangle",
+    "sketch.create_circle",
+    "sketch.create_polygon",
+    "feature.extrude",
+    "feature.set_parameter",
+    "feature.rename",
+    "feature.delete",
+  ],
+  featureKinds: ["rectangle", "circle", "polygon", "extrusion"],
+  sketchPlanes: ["xy", "xz", "yz"],
+  extrusionOperations: ["new_body", "union", "cut", "intersect"],
+  presets: ["blank", "mounting_plate", "l_bracket"],
+  atomicBatches: true,
+  optimisticConcurrency: true,
+  persistedIdempotency: true,
+  revisionRestore: true,
+  solidModeling: true,
+  stlExport: true,
+};
+
+interface IdempotencyRecord {
+  readonly requestId: CadRequestId;
+  readonly requestDigest: string;
+  readonly revision: number;
+}
+
+const IdempotencyRecordSchema = Schema.Struct({
+  requestId: CadRequestId,
+  requestDigest: Schema.String,
+  revision: NonNegativeInt,
+});
+
+interface RevisionCheckpoint {
+  readonly revision: number;
+  readonly features: ReadonlyArray<CadFeature>;
+}
+
+const RevisionCheckpointSchema = Schema.Struct({
+  revision: NonNegativeInt,
+  features: Schema.Array(CadFeature),
+});
+
+const PersistedCadDocumentSchema = Schema.Struct({
+  snapshot: CadDocumentSnapshot,
+  idempotency: Schema.Array(IdempotencyRecordSchema),
+  checkpoints: Schema.optionalKey(Schema.Array(RevisionCheckpointSchema)),
+});
+type PersistedCadDocument = typeof PersistedCadDocumentSchema.Type;
+
+const canonicalizeValue = (value: unknown): unknown => {
+  if (Array.isArray(value)) {
+    return value.map(canonicalizeValue);
+  }
+  if (value !== null && typeof value === "object") {
+    const sorted: Record<string, unknown> = {};
+    for (const key of Object.keys(value as Record<string, unknown>).toSorted()) {
+      const entry = (value as Record<string, unknown>)[key];
+      if (entry !== undefined) {
+        sorted[key] = canonicalizeValue(entry);
+      }
+    }
+    return sorted;
+  }
+  return value;
+};
+
+const computeCadRequestDigest = (input: {
+  readonly expectedRevision: number;
+  readonly actor: CadActor;
+  readonly commands: ReadonlyArray<CadCommand>;
+}): string => {
+  const canonical = JSON.stringify(
+    canonicalizeValue({
+      expectedRevision: input.expectedRevision,
+      actor: input.actor,
+      commands: input.commands,
+    }),
+  );
+  return NodeCrypto.createHash("sha256").update(canonical).digest("hex");
+};
+
+const computeCadRestoreDigest = (input: {
+  readonly expectedRevision: number;
+  readonly targetRevision: number;
+  readonly actor: CadActor;
+}): string => {
+  const canonical = JSON.stringify(
+    canonicalizeValue({
+      op: "restoreRevision",
+      expectedRevision: input.expectedRevision,
+      targetRevision: input.targetRevision,
+      actor: input.actor,
+    }),
+  );
+  return NodeCrypto.createHash("sha256").update(canonical).digest("hex");
+};
+
+const isPositiveDimension = (value: number): boolean =>
+  Number.isFinite(value) && value > 0 && value <= CAD_MAX_DIMENSION_MM;
+
+const isValidCoordinate = (value: number): boolean =>
+  Number.isFinite(value) && value >= -CAD_MAX_DIMENSION_MM && value <= CAD_MAX_DIMENSION_MM;
+
+const applySingleCommand = (
+  features: CadFeature[],
+  command: CadCommand,
+): { readonly features: CadFeature[]; readonly summary: string } | CadFeatureError => {
+  const existingIndex = features.findIndex((feature) => feature.id === command.featureId);
+
+  switch (command.op) {
+    case "sketch.create_rectangle": {
+      if (existingIndex !== -1) {
+        return new CadFeatureError({
+          code: "duplicate_id",
+          detail: `Feature '${command.featureId}' already exists.`,
+        });
+      }
+      const nextFeature: CadFeature = {
+        id: command.featureId,
+        kind: "rectangle",
+        ...(command.name !== undefined ? { name: command.name } : {}),
+        ...(command.plane !== undefined ? { plane: command.plane } : {}),
+        x: command.x ?? 0,
+        y: command.y ?? 0,
+        width: command.width,
+        height: command.height,
+      };
+      return {
+        features: [...features, nextFeature],
+        summary: `Created rectangle '${command.featureId}' (${nextFeature.width}x${nextFeature.height} mm${command.plane ? ` on ${command.plane.toUpperCase()}` : ""})`,
+      };
+    }
+
+    case "sketch.create_circle": {
+      if (existingIndex !== -1) {
+        return new CadFeatureError({
+          code: "duplicate_id",
+          detail: `Feature '${command.featureId}' already exists.`,
+        });
+      }
+      const nextFeature: CadFeature = {
+        id: command.featureId,
+        kind: "circle",
+        ...(command.name !== undefined ? { name: command.name } : {}),
+        ...(command.plane !== undefined ? { plane: command.plane } : {}),
+        cx: command.cx ?? 0,
+        cy: command.cy ?? 0,
+        radius: command.radius,
+      };
+      return {
+        features: [...features, nextFeature],
+        summary: `Created circle '${command.featureId}' (r=${nextFeature.radius} mm${command.plane ? ` on ${command.plane.toUpperCase()}` : ""})`,
+      };
+    }
+
+    case "sketch.create_polygon": {
+      if (existingIndex !== -1) {
+        return new CadFeatureError({
+          code: "duplicate_id",
+          detail: `Feature '${command.featureId}' already exists.`,
+        });
+      }
+      for (const [px, py] of command.points) {
+        if (!isValidCoordinate(px) || !isValidCoordinate(py)) {
+          return new CadFeatureError({
+            code: "invalid_parameter",
+            detail: `Polygon '${command.featureId}' coordinates must be within +/-${CAD_MAX_DIMENSION_MM} mm.`,
+          });
+        }
+      }
+      if (!isSimplePolygon(command.points)) {
+        return new CadFeatureError({
+          code: "geometry_invalid",
+          detail: `Polygon '${command.featureId}' must be non-self-intersecting with non-zero area.`,
+        });
+      }
+      const nextFeature: CadFeature = {
+        id: command.featureId,
+        kind: "polygon",
+        ...(command.name !== undefined ? { name: command.name } : {}),
+        ...(command.plane !== undefined ? { plane: command.plane } : {}),
+        points: command.points,
+      };
+      return {
+        features: [...features, nextFeature],
+        summary: `Created polygon '${command.featureId}' (${command.points.length} vertices${command.plane ? ` on ${command.plane.toUpperCase()}` : ""})`,
+      };
+    }
+
+    case "feature.extrude": {
+      if (existingIndex !== -1) {
+        return new CadFeatureError({
+          code: "duplicate_id",
+          detail: `Feature '${command.featureId}' already exists.`,
+        });
+      }
+      const profile = features.find((feature) => feature.id === command.profileId);
+      if (!profile || profile.kind === "extrusion") {
+        return new CadFeatureError({
+          code: "invalid_reference",
+          detail: `Extrusion '${command.featureId}' requires sketch profile '${command.profileId}'.`,
+        });
+      }
+      if (command.targetBodyId !== undefined) {
+        const targetBody = features.find((feature) => feature.id === command.targetBodyId);
+        if (!targetBody || targetBody.kind !== "extrusion") {
+          return new CadFeatureError({
+            code: "invalid_reference",
+            detail: `Extrusion '${command.featureId}' targetBodyId '${command.targetBodyId}' must reference an existing extrusion body.`,
+          });
+        }
+      }
+      const operation = command.operation ?? "new_body";
+      const zOffset = command.zOffset ?? 0;
+      const nextFeature: CadFeature = {
+        id: command.featureId,
+        kind: "extrusion",
+        ...(command.name !== undefined ? { name: command.name } : {}),
+        profileId: command.profileId,
+        depth: command.depth,
+        zOffset,
+        operation,
+        ...(command.targetBodyId !== undefined ? { targetBodyId: command.targetBodyId } : {}),
+      };
+      return {
+        features: [...features, nextFeature],
+        summary: `Extruded '${command.profileId}' as ${operation} '${command.featureId}' (${command.depth} mm)`,
+      };
+    }
+
+    case "feature.set_parameter": {
+      if (existingIndex === -1) {
+        return new CadFeatureError({
+          code: "feature_not_found",
+          detail: `Feature '${command.featureId}' was not found.`,
+        });
+      }
+      const target = features[existingIndex]!;
+      const value = command.value;
+
+      if (target.kind === "rectangle") {
+        if (command.parameter === "x" || command.parameter === "y") {
+          if (!isValidCoordinate(value)) {
+            return new CadFeatureError({
+              code: "invalid_parameter",
+              detail: `Parameter '${command.parameter}' must be within +/-${CAD_MAX_DIMENSION_MM} mm.`,
+            });
+          }
+          const updated = { ...target, [command.parameter]: value };
+          const next = [...features];
+          next[existingIndex] = updated;
+          return {
+            features: next,
+            summary: `Set ${command.featureId}.${command.parameter} = ${value}`,
+          };
+        }
+        if (command.parameter === "width" || command.parameter === "height") {
+          if (!isPositiveDimension(value)) {
+            return new CadFeatureError({
+              code: "invalid_parameter",
+              detail: `Dimension '${command.parameter}' must be > 0 and <= ${CAD_MAX_DIMENSION_MM} mm.`,
+            });
+          }
+          const updated = { ...target, [command.parameter]: value };
+          const next = [...features];
+          next[existingIndex] = updated;
+          return {
+            features: next,
+            summary: `Set ${command.featureId}.${command.parameter} = ${value}`,
+          };
+        }
+        return new CadFeatureError({
+          code: "invalid_parameter",
+          detail: `Rectangle feature '${command.featureId}' does not have parameter '${command.parameter}'.`,
+        });
+      }
+
+      if (target.kind === "circle") {
+        if (command.parameter === "cx" || command.parameter === "cy") {
+          if (!isValidCoordinate(value)) {
+            return new CadFeatureError({
+              code: "invalid_parameter",
+              detail: `Parameter '${command.parameter}' must be within +/-${CAD_MAX_DIMENSION_MM} mm.`,
+            });
+          }
+          const updated = { ...target, [command.parameter]: value };
+          const next = [...features];
+          next[existingIndex] = updated;
+          return {
+            features: next,
+            summary: `Set ${command.featureId}.${command.parameter} = ${value}`,
+          };
+        }
+        if (command.parameter === "radius") {
+          if (!isPositiveDimension(value)) {
+            return new CadFeatureError({
+              code: "invalid_parameter",
+              detail: `Dimension 'radius' must be > 0 and <= ${CAD_MAX_DIMENSION_MM} mm.`,
+            });
+          }
+          const updated = { ...target, radius: value };
+          const next = [...features];
+          next[existingIndex] = updated;
+          return {
+            features: next,
+            summary: `Set ${command.featureId}.radius = ${value}`,
+          };
+        }
+        return new CadFeatureError({
+          code: "invalid_parameter",
+          detail: `Circle feature '${command.featureId}' does not have parameter '${command.parameter}'.`,
+        });
+      }
+
+      if (target.kind === "polygon") {
+        return new CadFeatureError({
+          code: "invalid_parameter",
+          detail: `Polygon feature '${command.featureId}' does not support scalar parameter '${command.parameter}'.`,
+        });
+      }
+
+      if (command.parameter === "depth") {
+        if (!isPositiveDimension(value)) {
+          return new CadFeatureError({
+            code: "invalid_parameter",
+            detail: `Dimension 'depth' must be > 0 and <= ${CAD_MAX_DIMENSION_MM} mm.`,
+          });
+        }
+        const updated = { ...target, depth: value };
+        const next = [...features];
+        next[existingIndex] = updated;
+        return {
+          features: next,
+          summary: `Set ${command.featureId}.depth = ${value}`,
+        };
+      }
+      if (command.parameter === "zOffset") {
+        if (!isValidCoordinate(value)) {
+          return new CadFeatureError({
+            code: "invalid_parameter",
+            detail: `Parameter 'zOffset' must be within +/-${CAD_MAX_DIMENSION_MM} mm.`,
+          });
+        }
+        const updated = { ...target, zOffset: value };
+        const next = [...features];
+        next[existingIndex] = updated;
+        return {
+          features: next,
+          summary: `Set ${command.featureId}.zOffset = ${value}`,
+        };
+      }
+      return new CadFeatureError({
+        code: "invalid_parameter",
+        detail: `Extrusion feature '${command.featureId}' does not have parameter '${command.parameter}'.`,
+      });
+    }
+
+    case "feature.rename": {
+      if (existingIndex === -1) {
+        return new CadFeatureError({
+          code: "feature_not_found",
+          detail: `Feature '${command.featureId}' was not found.`,
+        });
+      }
+      const updated = { ...features[existingIndex]!, name: command.name };
+      const next = [...features];
+      next[existingIndex] = updated;
+      return {
+        features: next,
+        summary: `Renamed '${command.featureId}' to '${command.name}'`,
+      };
+    }
+
+    case "feature.delete": {
+      if (existingIndex === -1) {
+        return new CadFeatureError({
+          code: "feature_not_found",
+          detail: `Feature '${command.featureId}' was not found.`,
+        });
+      }
+      const dependent = features.find(
+        (feature) => feature.kind === "extrusion" && feature.profileId === command.featureId,
+      );
+      if (dependent) {
+        return new CadFeatureError({
+          code: "feature_in_use",
+          detail: `Sketch '${command.featureId}' is referenced by extrusion '${dependent.id}'.`,
+        });
+      }
+      return {
+        features: features.filter((feature) => feature.id !== command.featureId),
+        summary: `Deleted feature '${command.featureId}'`,
+      };
+    }
+  }
+};
