diff --git a/apps/server/src/cad/CadDocumentService.test.ts b/apps/server/src/cad/CadDocumentService.test.ts
new file mode 100644
index 00000000..bad5f01b
--- /dev/null
+++ b/apps/server/src/cad/CadDocumentService.test.ts
@@ -0,0 +1,400 @@
+import { assert, it } from "@effect/vitest";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import {
+  CadDocumentId,
+  CadFeatureId,
+  CadRequestId,
+  IsoDateTime,
+  NonNegativeInt,
+  type Project,
+  ProjectId,
+} from "@t3tools/contracts";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Fiber from "effect/Fiber";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Path from "effect/Path";
+import * as Stream from "effect/Stream";
+
+import * as ProjectService from "../project/ProjectService.ts";
+import * as WorkspacePaths from "../workspace/WorkspacePaths.ts";
+import * as CadDocumentService from "./CadDocumentService.ts";
+
+const PROJECT_ID = ProjectId.make("proj-cad-test");
+
+const makeTestLayer = (workspaceRoot: string) => {
+  const projectServiceStub = Layer.mock(ProjectService.ProjectService)({
+    getById: (projectId) => {
+      const project: Project = {
+        id: PROJECT_ID,
+        title: "CAD Test Project",
+        workspaceRoot,
+        defaultModelSelection: null,
+        scripts: [],
+        createdAt: IsoDateTime.make("2026-01-01T00:00:00.000Z"),
+        updatedAt: IsoDateTime.make("2026-01-01T00:00:00.000Z"),
+        deletedAt: null,
+      };
+      return projectId === PROJECT_ID ? Effect.succeedSome(project) : Effect.succeedNone;
+    },
+  });
+
+  return CadDocumentService.layer.pipe(
+    Layer.provideMerge(projectServiceStub),
+    Layer.provideMerge(WorkspacePaths.layer),
+    Layer.provideMerge(NodeServices.layer),
+  );
+};
+
+it.effect(
+  "creates mounting_plate preset, persists on disk, supports idempotency, and exports STL",
+  () =>
+    Effect.scoped(
+      Effect.gen(function* () {
+        const fs = yield* FileSystem.FileSystem;
+        const path = yield* Path.Path;
+        const workspaceRoot = yield* fs.makeTempDirectoryScoped({ prefix: "t3cad-doc-" });
+        const serviceLayer = makeTestLayer(workspaceRoot);
+
+        yield* Effect.gen(function* () {
+          const cad = yield* CadDocumentService.CadDocumentService;
+          const docId = CadDocumentId.make("bracket_v1");
+
+          const created = yield* cad.createDocument({
+            projectId: PROJECT_ID,
+            documentId: docId,
+            name: "Motor Mount Bracket",
+            preset: "mounting_plate",
+          });
+
+          assert.equal(created.revision, 1);
+          assert.equal(created.features.length, 10);
+          assert.equal(created.report.status, "valid");
+          assert.equal(created.report.watertight, true);
+          assert.isTrue(created.report.totalVolumeMm3 > 47_200);
+          assert.isTrue(created.report.totalVolumeMm3 < 47_400);
+
+          const listed = yield* cad.listDocuments({ projectId: PROJECT_ID });
+          assert.equal(listed.documents.length, 1);
+          assert.equal(listed.documents[0]?.documentId, docId);
+
+          const req1 = CadRequestId.make("req-widen-1");
+          const applyInput = {
+            projectId: PROJECT_ID,
+            documentId: docId,
+            requestId: req1,
+            expectedRevision: NonNegativeInt.make(1),
+            actor: { kind: "agent" as const, id: "cad-agent", label: "T3CAD Agent" },
+            commands: [
+              {
+                op: "feature.set_parameter" as const,
+                featureId: CadFeatureId.make("plate_sketch"),
+                parameter: "width" as const,
+                value: 120,
+              },
+            ],
+          };
+
+          const firstApply = yield* cad.applyCommands(applyInput);
+          assert.equal(firstApply.revision, 2);
+          assert.equal(firstApply.replayed, false);
+          assert.equal(firstApply.snapshot.history.at(-1)?.actor.kind, "agent");
+
+          const replayedApply = yield* cad.applyCommands(applyInput);
+          assert.equal(replayedApply.replayed, true);
+          assert.equal(replayedApply.revision, 2);
+
+          const conflictExit = yield* Effect.exit(
+            cad.applyCommands({
+              ...applyInput,
+              commands: [
+                {
+                  op: "feature.set_parameter" as const,
+                  featureId: CadFeatureId.make("plate_sketch"),
+                  parameter: "width" as const,
+                  value: 140,
+                },
+              ],
+            }),
+          );
+          assert.equal(conflictExit._tag, "Failure");
+
+          const staleExit = yield* Effect.exit(
+            cad.applyCommands({
+              ...applyInput,
+              requestId: CadRequestId.make("req-stale"),
+              expectedRevision: NonNegativeInt.make(1),
+            }),
+          );
+          assert.equal(staleExit._tag, "Failure");
+
+          const stl = yield* cad.exportStl({
+            projectId: PROJECT_ID,
+            documentId: docId,
+            relativePath: "exports/bracket.stl",
+          });
+          assert.equal(stl.writtenPath, "exports/bracket.stl");
+          assert.isTrue(stl.stlAscii.startsWith("solid Motor_Mount_Bracket"));
+          assert.isTrue(stl.triangleCount > 200);
+          assert.isTrue(yield* fs.exists(path.join(workspaceRoot, "exports/bracket.stl")));
+
+          const escapeExit = yield* Effect.exit(
+            cad.exportStl({
+              projectId: PROJECT_ID,
+              documentId: docId,
+              relativePath: "../escape.stl",
+            }),
+          );
+          assert.equal(escapeExit._tag, "Failure");
+        }).pipe(Effect.provide(serviceLayer));
+
+        yield* Effect.gen(function* () {
+          const cad = yield* CadDocumentService.CadDocumentService;
+          const docId = CadDocumentId.make("bracket_v1");
+          const reloaded = yield* cad.inspectDocument({ projectId: PROJECT_ID, documentId: docId });
+          assert.equal(reloaded.revision, 2);
+
+          const replayedAcrossRestart = yield* cad.applyCommands({
+            projectId: PROJECT_ID,
+            documentId: docId,
+            requestId: CadRequestId.make("req-widen-1"),
+            expectedRevision: NonNegativeInt.make(1),
+            actor: { kind: "agent", id: "cad-agent", label: "T3CAD Agent" },
+            commands: [
+              {
+                op: "feature.set_parameter",
+                featureId: CadFeatureId.make("plate_sketch"),
+                parameter: "width",
+                value: 120,
+              },
+            ],
+          });
+          assert.equal(replayedAcrossRestart.replayed, true);
+          assert.equal(replayedAcrossRestart.revision, 2);
+        }).pipe(Effect.provide(makeTestLayer(workspaceRoot)));
+      }),
+    ).pipe(Effect.provide(NodeServices.layer)),
+);
+
+it.effect("rolls back entire batch on invalid step and streams live document updates", () =>
+  Effect.scoped(
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const workspaceRoot = yield* fs.makeTempDirectoryScoped({ prefix: "t3cad-batch-" });
+      const serviceLayer = makeTestLayer(workspaceRoot);
+
+      yield* Effect.gen(function* () {
+        const cad = yield* CadDocumentService.CadDocumentService;
+        const docId = CadDocumentId.make("rollback_part");
+        yield* cad.createDocument({
+          projectId: PROJECT_ID,
+          documentId: docId,
+          preset: "blank",
+        });
+
+        const ready = yield* Deferred.make<void>();
+        const eventsFiber = yield* cad
+          .subscribeDocument({ projectId: PROJECT_ID, documentId: docId })
+          .pipe(
+            Stream.tap(() => Deferred.succeed(ready, undefined)),
+            Stream.take(2),
+            Stream.runCollect,
+            Effect.forkScoped,
+          );
+        yield* Deferred.await(ready);
+
+        const badBatch = yield* Effect.exit(
+          cad.applyCommands({
+            projectId: PROJECT_ID,
+            documentId: docId,
+            requestId: CadRequestId.make("req-atomic-fail"),
+            expectedRevision: NonNegativeInt.make(0),
+            actor: { kind: "user", id: "designer" },
+            commands: [
+              {
+                op: "sketch.create_rectangle",
+                featureId: CadFeatureId.make("rect_a"),
+                width: 40,
+                height: 20,
+              },
+              {
+                op: "feature.extrude",
+                featureId: CadFeatureId.make("ext_bad"),
+                profileId: CadFeatureId.make("missing_sketch"),
+                depth: 10,
+              },
+            ],
+          }),
+        );
+        assert.equal(badBatch._tag, "Failure");
+
+        const afterFailedBatch = yield* cad.inspectDocument({
+          projectId: PROJECT_ID,
+          documentId: docId,
+        });
+        assert.equal(afterFailedBatch.revision, 0);
+        assert.equal(afterFailedBatch.features.length, 0);
+
+        yield* cad.applyCommands({
+          projectId: PROJECT_ID,
+          documentId: docId,
+          requestId: CadRequestId.make("req-valid-1"),
+          expectedRevision: NonNegativeInt.make(0),
+          actor: { kind: "user", id: "designer" },
+          commands: [
+            {
+              op: "sketch.create_rectangle",
+              featureId: CadFeatureId.make("rect_a"),
+              width: 40,
+              height: 20,
+            },
+          ],
+        });
+
+        const deleteInUse = yield* cad
+          .applyCommands({
+            projectId: PROJECT_ID,
+            documentId: docId,
+            requestId: CadRequestId.make("req-extrude-1"),
+            expectedRevision: NonNegativeInt.make(1),
+            actor: { kind: "user", id: "designer" },
+            commands: [
+              {
+                op: "feature.extrude",
+                featureId: CadFeatureId.make("ext_a"),
+                profileId: CadFeatureId.make("rect_a"),
+                depth: 5,
+              },
+              {
+                op: "feature.delete",
+                featureId: CadFeatureId.make("rect_a"),
+              },
+            ],
+          })
+          .pipe(Effect.exit);
+        assert.equal(deleteInUse._tag, "Failure");
+
+        const received = yield* Fiber.join(eventsFiber);
+        assert.equal(received.length, 2);
+        assert.equal(received[0]?._tag, "snapshot");
+        assert.equal(received[1]?._tag, "snapshot");
+        if (received[1]?._tag === "snapshot") {
+          assert.equal(received[1].snapshot.revision, 1);
+        }
+      }).pipe(Effect.provide(serviceLayer));
+    }),
+  ).pipe(Effect.provide(NodeServices.layer)),
+);
+
+it.effect(
+  "supports 3D l_bracket preset, polygon validation, revision restore, and project stream",
+  () =>
+    Effect.scoped(
+      Effect.gen(function* () {
+        const fs = yield* FileSystem.FileSystem;
+        const workspaceRoot = yield* fs.makeTempDirectoryScoped({ prefix: "t3cad-wave1-" });
+        const serviceLayer = makeTestLayer(workspaceRoot);
+
+        yield* Effect.gen(function* () {
+          const cad = yield* CadDocumentService.CadDocumentService;
+          const docId = CadDocumentId.make("l_bracket_doc");
+
+          const projectReady = yield* Deferred.make<void>();
+          const projectStreamFiber = yield* cad.subscribeProject({ projectId: PROJECT_ID }).pipe(
+            Stream.tap(() => Deferred.succeed(projectReady, undefined)),
+            Stream.take(2),
+            Stream.runCollect,
+            Effect.forkScoped,
+          );
+          yield* Deferred.await(projectReady);
+
+          const created = yield* cad.createDocument({
+            projectId: PROJECT_ID,
+            documentId: docId,
+            name: "3D L-Bracket",
+            preset: "l_bracket",
+          });
+
+          assert.equal(created.revision, 1);
+          assert.equal(created.report.status, "valid");
+          assert.equal(created.report.watertight, true);
+          assert.deepEqual(created.report.boundsMm, { min: [0, 0, 0], max: [80, 50, 60] });
+          assert.isTrue(created.report.totalVolumeMm3 > 63_500);
+          assert.isTrue(created.report.totalVolumeMm3 < 64_800);
+
+          // Self-intersecting bowtie polygon must be rejected.
+          const bowtieExit = yield* Effect.exit(
+            cad.applyCommands({
+              projectId: PROJECT_ID,
+              documentId: docId,
+              requestId: CadRequestId.make("req-bowtie"),
+              expectedRevision: NonNegativeInt.make(1),
+              actor: { kind: "user", id: "designer" },
+              commands: [
+                {
+                  op: "sketch.create_polygon",
+                  featureId: CadFeatureId.make("bad_poly"),
+                  points: [
+                    [0, 0],
+                    [10, 10],
+                    [10, 0],
+                    [0, 10],
+                  ],
+                },
+              ],
+            }),
+          );
+          assert.equal(bowtieExit._tag, "Failure");
+
+          const modified = yield* cad.applyCommands({
+            projectId: PROJECT_ID,
+            documentId: docId,
+            requestId: CadRequestId.make("req-widen-bracket"),
+            expectedRevision: NonNegativeInt.make(1),
+            actor: { kind: "user", id: "designer" },
+            commands: [
+              {
+                op: "feature.set_parameter",
+                featureId: CadFeatureId.make("base_flange_sketch"),
+                parameter: "width",
+                value: 110,
+              },
+            ],
+          });
+          assert.equal(modified.revision, 2);
+          assert.deepEqual(modified.snapshot.report.boundsMm, {
+            min: [0, 0, 0],
+            max: [110, 50, 60],
+          });
+
+          const restoreInput = {
+            projectId: PROJECT_ID,
+            documentId: docId,
+            requestId: CadRequestId.make("req-restore-r1"),
+            expectedRevision: NonNegativeInt.make(2),
+            targetRevision: NonNegativeInt.make(1),
+            actor: { kind: "user" as const, id: "designer" },
+          };
+          const restored = yield* cad.restoreRevision(restoreInput);
+          assert.equal(restored.revision, 3);
+          assert.equal(restored.replayed, false);
+          assert.deepEqual(restored.snapshot.report.boundsMm, {
+            min: [0, 0, 0],
+            max: [80, 50, 60],
+          });
+          assert.equal(restored.snapshot.report.totalVolumeMm3, created.report.totalVolumeMm3);
+
+          const replayedRestore = yield* cad.restoreRevision(restoreInput);
+          assert.equal(replayedRestore.replayed, true);
+          assert.equal(replayedRestore.revision, 3);
+
+          const projectEvents = yield* Fiber.join(projectStreamFiber);
+          assert.equal(projectEvents.length, 2);
+          assert.equal(projectEvents[0]?.documents.length, 0);
+          assert.equal(projectEvents[1]?.documents.length, 1);
+          assert.equal(projectEvents[1]?.documents[0]?.documentId, docId);
+        }).pipe(Effect.provide(serviceLayer));
+      }),
+    ).pipe(Effect.provide(NodeServices.layer)),
+);
