@@ -0,0 +1,989 @@
+import type {
+  CadBoundsMm,
+  CadExtrusionFeature,
+  CadFeature,
+  CadGeometryReport,
+  CadMeshBody,
+  CadSketchPlane,
+  CadVec2,
+} from "@t3tools/contracts";
+
+const EPSILON = 1e-5;
+const CIRCLE_SEGMENTS = 36;
+
+interface Vec3 {
+  readonly x: number;
+  readonly y: number;
+  readonly z: number;
+}
+
+const vec = (x: number, y: number, z: number): Vec3 => ({ x, y, z });
+const add = (a: Vec3, b: Vec3): Vec3 => vec(a.x + b.x, a.y + b.y, a.z + b.z);
+const sub = (a: Vec3, b: Vec3): Vec3 => vec(a.x - b.x, a.y - b.y, a.z - b.z);
+const scale = (a: Vec3, s: number): Vec3 => vec(a.x * s, a.y * s, a.z * s);
+const dot = (a: Vec3, b: Vec3): number => a.x * b.x + a.y * b.y + a.z * b.z;
+const cross = (a: Vec3, b: Vec3): Vec3 =>
+  vec(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x);
+const length = (a: Vec3): number => Math.hypot(a.x, a.y, a.z);
+const normalize = (a: Vec3): Vec3 => {
+  const len = length(a);
+  return len > 0 ? scale(a, 1 / len) : vec(0, 0, 1);
+};
+const lerp = (a: Vec3, b: Vec3, t: number): Vec3 => add(a, scale(sub(b, a), t));
+
+interface Plane {
+  normal: Vec3;
+  w: number;
+}
+
+const planeFromPoints = (a: Vec3, b: Vec3, c: Vec3): Plane | null => {
+  const n = cross(sub(b, a), sub(c, a));
+  const len = length(n);
+  if (len <= 1e-10) return null;
+  const normal = scale(n, 1 / len);
+  return { normal, w: dot(normal, a) };
+};
+
+const flipPlane = (plane: Plane): Plane => ({
+  normal: scale(plane.normal, -1),
+  w: -plane.w,
+});
+
+interface Polygon {
+  vertices: Vec3[];
+  plane: Plane;
+}
+
+const makePolygon = (vertices: Vec3[]): Polygon | null => {
+  if (vertices.length < 3) return null;
+  for (let i = 2; i < vertices.length; i++) {
+    const plane = planeFromPoints(vertices[0]!, vertices[1]!, vertices[i]!);
+    if (plane !== null) {
+      return { vertices: [...vertices], plane };
+    }
+  }
+  return null;
+};
+
+const flipPolygon = (polygon: Polygon): Polygon => ({
+  vertices: [...polygon.vertices].reverse(),
+  plane: flipPlane(polygon.plane),
+});
+
+const COPLANAR = 0;
+const FRONT = 1;
+const BACK = 2;
+const SPANNING = 3;
+
+const splitPolygon = (
+  plane: Plane,
+  polygon: Polygon,
+  coplanarFront: Polygon[],
+  coplanarBack: Polygon[],
+  front: Polygon[],
+  back: Polygon[],
+): void => {
+  let polygonType = 0;
+  const types: number[] = [];
+
+  for (const v of polygon.vertices) {
+    const t = dot(plane.normal, v) - plane.w;
+    const type = t < -EPSILON ? BACK : t > EPSILON ? FRONT : COPLANAR;
+    polygonType |= type;
+    types.push(type);
+  }
+
+  switch (polygonType) {
+    case COPLANAR:
+      if (dot(plane.normal, polygon.plane.normal) > 0) {
+        coplanarFront.push(polygon);
+      } else {
+        coplanarBack.push(polygon);
+      }
+      break;
+    case FRONT:
+      front.push(polygon);
+      break;
+    case BACK:
+      back.push(polygon);
+      break;
+    case SPANNING: {
+      const f: Vec3[] = [];
+      const b: Vec3[] = [];
+      const count = polygon.vertices.length;
+      for (let i = 0; i < count; i++) {
+        const j = (i + 1) % count;
+        const ti = types[i]!;
+        const tj = types[j]!;
+        const vi = polygon.vertices[i]!;
+        const vj = polygon.vertices[j]!;
+        if (ti !== BACK) f.push(vi);
+        if (ti !== FRONT) b.push(vi);
+        if ((ti | tj) === SPANNING) {
+          const denom = dot(plane.normal, sub(vj, vi));
+          if (Math.abs(denom) > 1e-12) {
+            const t = (plane.w - dot(plane.normal, vi)) / denom;
+            const mid = lerp(vi, vj, Math.max(0, Math.min(1, t)));
+            f.push(mid);
+            b.push(mid);
+          }
+        }
+      }
+      const frontPoly = makePolygon(f);
+      if (frontPoly) front.push(frontPoly);
+      const backPoly = makePolygon(b);
+      if (backPoly) back.push(backPoly);
+      break;
+    }
+  }
+};
+
+class BspNode {
+  plane: Plane | null = null;
+  front: BspNode | null = null;
+  back: BspNode | null = null;
+  polygons: Polygon[] = [];
+
+  constructor(polygons?: Polygon[]) {
+    if (polygons && polygons.length > 0) {
+      this.build(polygons);
+    }
+  }
+
+  clone(): BspNode {
+    const node = new BspNode();
+    node.plane = this.plane ? { normal: { ...this.plane.normal }, w: this.plane.w } : null;
+    node.polygons = this.polygons.map((p) => ({
+      vertices: p.vertices.map((v) => ({ ...v })),
+      plane: { normal: { ...p.plane.normal }, w: p.plane.w },
+    }));
+    node.front = this.front ? this.front.clone() : null;
+    node.back = this.back ? this.back.clone() : null;
+    return node;
+  }
+
+  invert(): void {
+    this.polygons = this.polygons.map(flipPolygon);
+    if (this.plane) this.plane = flipPlane(this.plane);
+    if (this.front) this.front.invert();
+    if (this.back) this.back.invert();
+    const tmp = this.front;
+    this.front = this.back;
+    this.back = tmp;
+  }
+
+  clipPolygons(polygons: Polygon[]): Polygon[] {
+    if (!this.plane) return [...polygons];
+    let front: Polygon[] = [];
+    let back: Polygon[] = [];
+    for (const polygon of polygons) {
+      splitPolygon(this.plane, polygon, front, back, front, back);
+    }
+    if (this.front) front = this.front.clipPolygons(front);
+    back = this.back ? this.back.clipPolygons(back) : [];
+    return [...front, ...back];
+  }
+
+  clipTo(bsp: BspNode): void {
+    this.polygons = bsp.clipPolygons(this.polygons);
+    if (this.front) this.front.clipTo(bsp);
+    if (this.back) this.back.clipTo(bsp);
+  }
+
+  allPolygons(): Polygon[] {
+    let result = [...this.polygons];
+    if (this.front) result = result.concat(this.front.allPolygons());
+    if (this.back) result = result.concat(this.back.allPolygons());
+    return result;
+  }
+
+  build(polygons: Polygon[]): void {
+    if (polygons.length === 0) return;
+    if (!this.plane) {
+      this.plane = polygons[0]!.plane;
+    }
+    const front: Polygon[] = [];
+    const back: Polygon[] = [];
+    for (const polygon of polygons) {
+      splitPolygon(this.plane, polygon, this.polygons, this.polygons, front, back);
+    }
+    if (front.length > 0) {
+      if (!this.front) this.front = new BspNode();
+      this.front.build(front);
+    }
+    if (back.length > 0) {
+      if (!this.back) this.back = new BspNode();
+      this.back.build(back);
+    }
+  }
+}
+
+class CsgSolid {
+  readonly polygons: Polygon[];
+
+  constructor(polygons: Polygon[]) {
+    this.polygons = polygons;
+  }
+
+  union(other: CsgSolid): CsgSolid {
+    const a = new BspNode(this.polygons);
+    const b = new BspNode(other.polygons);
+    a.clipTo(b);
+    b.clipTo(a);
+    b.invert();
+    b.clipTo(a);
+    b.invert();
+    a.build(b.allPolygons());
+    return new CsgSolid(a.allPolygons());
+  }
+
+  subtract(other: CsgSolid): CsgSolid {
+    const a = new BspNode(this.polygons);
+    const b = new BspNode(other.polygons);
+    a.invert();
+    a.clipTo(b);
+    b.clipTo(a);
+    b.invert();
+    b.clipTo(a);
+    b.invert();
+    a.build(b.allPolygons());
+    a.invert();
+    return new CsgSolid(a.allPolygons());
+  }
+
+  intersect(other: CsgSolid): CsgSolid {
+    const a = new BspNode(this.polygons);
+    const b = new BspNode(other.polygons);
+    a.invert();
+    b.clipTo(a);
+    b.invert();
+    a.clipTo(b);
+    b.clipTo(a);
+    a.build(b.allPolygons());
+    a.invert();
+    return new CsgSolid(a.allPolygons());
+  }
+}
+
+type Vec2 = readonly [number, number];
+
+const cross2D = (a: Vec2, b: Vec2, c: Vec2): number =>
+  (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0]);
+
+const signedPolygonArea2 = (points: ReadonlyArray<Vec2>): number => {
+  let area2 = 0;
+  for (let i = 0; i < points.length; i++) {
+    const [x0, y0] = points[i]!;
+    const [x1, y1] = points[(i + 1) % points.length]!;
+    area2 += x0 * y1 - x1 * y0;
+  }
+  return area2;
+};
+
+const deduplicateRing = (points: ReadonlyArray<Vec2>): Vec2[] => {
+  const cleaned: Vec2[] = [];
+  for (const p of points) {
+    const prev = cleaned[cleaned.length - 1];
+    if (!prev || Math.hypot(p[0] - prev[0], p[1] - prev[1]) > 1e-8) {
+      cleaned.push(p);
+    }
+  }
+  if (
+    cleaned.length > 1 &&
+    Math.hypot(
+      cleaned[0]![0] - cleaned[cleaned.length - 1]![0],
+      cleaned[0]![1] - cleaned[cleaned.length - 1]![1],
+    ) <= 1e-8
+  ) {
+    cleaned.pop();
+  }
+  return cleaned;
+};
+
+const onSegment2D = (p: Vec2, a: Vec2, b: Vec2): boolean =>
+  p[0] >= Math.min(a[0], b[0]) - 1e-9 &&
+  p[0] <= Math.max(a[0], b[0]) + 1e-9 &&
+  p[1] >= Math.min(a[1], b[1]) - 1e-9 &&
+  p[1] <= Math.max(a[1], b[1]) + 1e-9 &&
+  Math.abs(cross2D(a, b, p)) <= 1e-9;
+
+const segmentsIntersectProper = (a0: Vec2, a1: Vec2, b0: Vec2, b1: Vec2): boolean => {
+  const d1 = cross2D(b0, b1, a0);
+  const d2 = cross2D(b0, b1, a1);
+  const d3 = cross2D(a0, a1, b0);
+  const d4 = cross2D(a0, a1, b1);
+
+  if (
+    ((d1 > 1e-9 && d2 < -1e-9) || (d1 < -1e-9 && d2 > 1e-9)) &&
+    ((d3 > 1e-9 && d4 < -1e-9) || (d3 < -1e-9 && d4 > 1e-9))
+  ) {
+    return true;
+  }
+  return (
+    onSegment2D(a0, b0, b1) ||
+    onSegment2D(a1, b0, b1) ||
+    onSegment2D(b0, a0, a1) ||
+    onSegment2D(b1, a0, a1)
+  );
+};
+
+export const isSimplePolygon = (points: ReadonlyArray<Vec2>): boolean => {
+  const ring = deduplicateRing(points);
+  const n = ring.length;
+  if (n < 3) return false;
+  if (Math.abs(signedPolygonArea2(ring)) <= 1e-6) return false;
+  for (let i = 0; i < n; i++) {
+    const a0 = ring[i]!;
+    const a1 = ring[(i + 1) % n]!;
+    for (let j = i + 1; j < n; j++) {
+      // Skip shared-vertex adjacent edges (but check wraparound non-adjacent).
+      if (j === i || j === (i + 1) % n || i === (j + 1) % n) continue;
+      const b0 = ring[j]!;
+      const b1 = ring[(j + 1) % n]!;
+      if (segmentsIntersectProper(a0, a1, b0, b1)) {
+        return false;
+      }
+    }
+  }
+  return true;
+};
+
+const pointInTriangleCcw = (p: Vec2, a: Vec2, b: Vec2, c: Vec2): boolean =>
+  cross2D(a, b, p) >= -1e-9 && cross2D(b, c, p) >= -1e-9 && cross2D(c, a, p) >= -1e-9;
+
+const triangulateSimplePolygonCcw = (
+  ccwRing: ReadonlyArray<Vec2>,
+): Array<readonly [Vec2, Vec2, Vec2]> => {
+  // Remove redundant collinear points along straight edges first so ear clipping stays robust.
+  const simplified: Vec2[] = [];
+  const rawLen = ccwRing.length;
+  for (let i = 0; i < rawLen; i++) {
+    const prev = ccwRing[(i - 1 + rawLen) % rawLen]!;
+    const curr = ccwRing[i]!;
+    const next = ccwRing[(i + 1) % rawLen]!;
+    if (Math.abs(cross2D(prev, curr, next)) > 1e-9) {
+      simplified.push(curr);
+    }
+  }
+  const verts = simplified.length >= 3 ? simplified : [...ccwRing];
+  if (verts.length < 3) return [];
+  if (verts.length === 3) return [[verts[0]!, verts[1]!, verts[2]!]];
+
+  const indices = verts.map((_, i) => i);
+  const triangles: Array<readonly [Vec2, Vec2, Vec2]> = [];
+  let guard = indices.length * indices.length * 2;
+
+  while (indices.length > 3 && guard > 0) {
+    guard -= 1;
+    let clipped = false;
+    const m = indices.length;
+    for (let i = 0; i < m; i++) {
+      const iPrev = indices[(i - 1 + m) % m]!;
+      const iCurr = indices[i]!;
+      const iNext = indices[(i + 1) % m]!;
+      const a = verts[iPrev]!;
+      const b = verts[iCurr]!;
+      const c = verts[iNext]!;
+      if (cross2D(a, b, c) <= 1e-9) continue;
+
+      let containsOther = false;
+      for (let j = 0; j < m; j++) {
+        const idx = indices[j]!;
+        if (idx === iPrev || idx === iCurr || idx === iNext) continue;
+        if (pointInTriangleCcw(verts[idx]!, a, b, c)) {
+          containsOther = true;
+          break;
+        }
+      }
+      if (containsOther) continue;
+
+      triangles.push([a, b, c]);
+      indices.splice(i, 1);
+      clipped = true;
+      break;
+    }
+    if (!clipped) break;
+  }
+
+  if (indices.length === 3) {
+    triangles.push([verts[indices[0]!]!, verts[indices[1]!]!, verts[indices[2]!]!]);
+  }
+  return triangles;
+};
+
+const planeToVec3 = (plane: CadSketchPlane, u: number, v: number, w: number): Vec3 => {
+  switch (plane) {
+    case "xy":
+      return vec(u, v, w);
+    case "xz":
+      return vec(u, w, v);
+    case "yz":
+      return vec(w, u, v);
+  }
+};
+
+// "xz" maps (u, w, v), where (eu x ev) . ew = -1 (left-handed), so cap/side winding must reverse.
+const isLeftHandedPlane = (plane: CadSketchPlane): boolean => plane === "xz";
+
+const extrudeConvexRing = (
+  ccwRing: ReadonlyArray<Vec2>,
+  plane: CadSketchPlane,
+  w0: number,
+  w1: number,
+): CsgSolid => {
+  const ring = isLeftHandedPlane(plane) ? [...ccwRing].reverse() : ccwRing;
+  const polygons: Polygon[] = [];
+  const n = ring.length;
+
+  const bottomVertices = [...ring].reverse().map(([u, v]) => planeToVec3(plane, u, v, w0));
+  const bottom = makePolygon(bottomVertices);
+  if (bottom) polygons.push(bottom);
+
+  const topVertices = ring.map(([u, v]) => planeToVec3(plane, u, v, w1));
+  const top = makePolygon(topVertices);
+  if (top) polygons.push(top);
+
+  for (let i = 0; i < n; i++) {
+    const j = (i + 1) % n;
+    const [u0, v0] = ring[i]!;
+    const [u1, v1] = ring[j]!;
+    const side = makePolygon([
+      planeToVec3(plane, u0, v0, w0),
+      planeToVec3(plane, u1, v1, w0),
+      planeToVec3(plane, u1, v1, w1),
+      planeToVec3(plane, u0, v0, w1),
+    ]);
+    if (side) polygons.push(side);
+  }
+
+  return new CsgSolid(polygons);
+};
+
+const extrudeArbitraryRing = (
+  rawPoints: ReadonlyArray<CadVec2>,
+  plane: CadSketchPlane,
+  w0: number,
+  w1: number,
+): CsgSolid => {
+  const cleaned = deduplicateRing(rawPoints);
+  if (cleaned.length < 3) {
+    return new CsgSolid([]);
+  }
+  const ccwRing = signedPolygonArea2(cleaned) < 0 ? [...cleaned].reverse() : cleaned;
+  const trianglesCcw = triangulateSimplePolygonCcw(ccwRing);
+
+  const leftHanded = isLeftHandedPlane(plane);
+  const orientedRing = leftHanded ? [...ccwRing].reverse() : ccwRing;
+  const orientedTriangles = leftHanded
+    ? trianglesCcw.map(([a, b, c]) => [a, c, b] as const)
+    : trianglesCcw;
+
+  const polygons: Polygon[] = [];
+
+  for (const [a, b, c] of orientedTriangles) {
+    const topCap = makePolygon([
+      planeToVec3(plane, a[0], a[1], w1),
+      planeToVec3(plane, b[0], b[1], w1),
+      planeToVec3(plane, c[0], c[1], w1),
+    ]);
+    if (topCap) polygons.push(topCap);
+
+    const bottomCap = makePolygon([
+      planeToVec3(plane, a[0], a[1], w0),
+      planeToVec3(plane, c[0], c[1], w0),
+      planeToVec3(plane, b[0], b[1], w0),
+    ]);
+    if (bottomCap) polygons.push(bottomCap);
+  }
+
+  const n = orientedRing.length;
+  for (let i = 0; i < n; i++) {
+    const j = (i + 1) % n;
+    const [u0, v0] = orientedRing[i]!;
+    const [u1, v1] = orientedRing[j]!;
+    const side = makePolygon([
+      planeToVec3(plane, u0, v0, w0),
+      planeToVec3(plane, u1, v1, w0),
+      planeToVec3(plane, u1, v1, w1),
+      planeToVec3(plane, u0, v0, w1),
+    ]);
+    if (side) polygons.push(side);
+  }
+
+  return new CsgSolid(polygons);
+};
+
+const boundsFromPlaneBox = (
+  plane: CadSketchPlane,
+  minU: number,
+  maxU: number,
+  minV: number,
+  maxV: number,
+  w0: number,
+  w1: number,
+): CadBoundsMm => {
+  const p0 = planeToVec3(plane, minU, minV, w0);
+  const p1 = planeToVec3(plane, maxU, maxV, w1);
+  return {
+    min: [Math.min(p0.x, p1.x), Math.min(p0.y, p1.y), Math.min(p0.z, p1.z)],
+    max: [Math.max(p0.x, p1.x), Math.max(p0.y, p1.y), Math.max(p0.z, p1.z)],
+  };
+};
+
+const buildSolidForExtrusion = (
+  extrusion: CadExtrusionFeature,
+  byId: ReadonlyMap<string, CadFeature>,
+): { readonly solid: CsgSolid; readonly bounds: CadBoundsMm } => {
+  const profile = byId.get(extrusion.profileId);
+  if (!profile || profile.kind === "extrusion") {
+    throw new Error(
+      `Extrusion '${extrusion.id}' references missing or non-profile '${extrusion.profileId}'.`,
+    );
+  }
+  const w0 = extrusion.zOffset;
+  const w1 = extrusion.zOffset + extrusion.depth;
+  const plane: CadSketchPlane = profile.plane ?? "xy";
+
+  if (profile.kind === "rectangle") {
+    const u0 = profile.x;
+    const v0 = profile.y;
+    const u1 = profile.x + profile.width;
+    const v1 = profile.y + profile.height;
+    return {
+      solid: extrudeConvexRing(
+        [
+          [u0, v0],
+          [u1, v0],
+          [u1, v1],
+          [u0, v1],
+        ],
+        plane,
+        w0,
+        w1,
+      ),
+      bounds: boundsFromPlaneBox(plane, u0, u1, v0, v1, w0, w1),
+    };
+  }
+
+  if (profile.kind === "circle") {
+    const ring: Vec2[] = [];
+    for (let i = 0; i < CIRCLE_SEGMENTS; i++) {
+      const angle = (2 * Math.PI * i) / CIRCLE_SEGMENTS;
+      ring.push([
+        profile.cx + profile.radius * Math.cos(angle),
+        profile.cy + profile.radius * Math.sin(angle),
+      ]);
+    }
+    return {
+      solid: extrudeConvexRing(ring, plane, w0, w1),
+      bounds: boundsFromPlaneBox(
+        plane,
+        profile.cx - profile.radius,
+        profile.cx + profile.radius,
+        profile.cy - profile.radius,
+        profile.cy + profile.radius,
+        w0,
+        w1,
+      ),
+    };
+  }
+
+  let minU = Infinity;
+  let minV = Infinity;
+  let maxU = -Infinity;
+  let maxV = -Infinity;
+  for (const [u, v] of profile.points) {
+    if (u < minU) minU = u;
+    if (v < minV) minV = v;
+    if (u > maxU) maxU = u;
+    if (v > maxV) maxV = v;
+  }
+  return {
+    solid: extrudeArbitraryRing(profile.points, plane, w0, w1),
+    bounds: boundsFromPlaneBox(plane, minU, maxU, minV, maxV, w0, w1),
+  };
+};
+
+const boundsOverlap = (a: CadBoundsMm, b: CadBoundsMm): boolean =>
+  a.min[0] <= b.max[0] + EPSILON &&
+  a.max[0] >= b.min[0] - EPSILON &&
+  a.min[1] <= b.max[1] + EPSILON &&
+  a.max[1] >= b.min[1] - EPSILON &&
+  a.min[2] <= b.max[2] + EPSILON &&
+  a.max[2] >= b.min[2] - EPSILON;
+
+const intersectBounds = (a: CadBoundsMm, b: CadBoundsMm): CadBoundsMm => ({
+  min: [Math.max(a.min[0], b.min[0]), Math.max(a.min[1], b.min[1]), Math.max(a.min[2], b.min[2])],
+  max: [Math.min(a.max[0], b.max[0]), Math.min(a.max[1], b.max[1]), Math.min(a.max[2], b.max[2])],
+});
+
+const quantizeVertexKey = (v: Vec3): string =>
+  `${Math.round(v.x * 1e4)}:${Math.round(v.y * 1e4)}:${Math.round(v.z * 1e4)}`;
+
+interface RawTriangle {
+  readonly v0: Vec3;
+  readonly v1: Vec3;
+  readonly v2: Vec3;
+  readonly normal: Vec3;
+}
+
+const splitTriangleEdge = (
+  tri: RawTriangle,
+  uniqueVertices: ReadonlyArray<Vec3>,
+): RawTriangle[] => {
+  const verts = [tri.v0, tri.v1, tri.v2] as const;
+  for (let edgeIndex = 0; edgeIndex < 3; edgeIndex++) {
+    const a = verts[edgeIndex]!;
+    const b = verts[(edgeIndex + 1) % 3]!;
+    const c = verts[(edgeIndex + 2) % 3]!;
+    const ab = sub(b, a);
+    const abLenSq = dot(ab, ab);
+    if (abLenSq <= 1e-10) continue;
+
+    const minX = Math.min(a.x, b.x) - 1e-4;
+    const maxX = Math.max(a.x, b.x) + 1e-4;
+    const minY = Math.min(a.y, b.y) - 1e-4;
+    const maxY = Math.max(a.y, b.y) + 1e-4;
+    const minZ = Math.min(a.z, b.z) - 1e-4;
+    const maxZ = Math.max(a.z, b.z) + 1e-4;
+
+    const splits: Array<{ t: number; v: Vec3 }> = [];
+    for (const p of uniqueVertices) {
+      if (p.x < minX || p.x > maxX || p.y < minY || p.y > maxY || p.z < minZ || p.z > maxZ) {
+        continue;
+      }
+      const ap = sub(p, a);
+      const t = dot(ap, ab) / abLenSq;
+      if (t <= 1e-5 || t >= 1 - 1e-5) continue;
+      const proj = add(a, scale(ab, t));
+      if (length(sub(p, proj)) <= 1e-4) {
+        splits.push({ t, v: p });
+      }
+    }
+
+    if (splits.length > 0) {
+      splits.sort((u, v) => u.t - v.t);
+      const chain: Vec3[] = [a];
+      for (const s of splits) {
+        if (length(sub(s.v, chain[chain.length - 1]!)) > 1e-5) {
+          chain.push(s.v);
+        }
+      }
+      if (length(sub(b, chain[chain.length - 1]!)) > 1e-5) {
+        chain.push(b);
+      }
+      if (chain.length >= 3) {
+        const result: RawTriangle[] = [];
+        for (let i = 0; i < chain.length - 1; i++) {
+          const p0 = chain[i]!;
+          const p1 = chain[i + 1]!;
+          const subTri = { v0: p0, v1: p1, v2: c, normal: tri.normal };
+          result.push(...splitTriangleEdge(subTri, uniqueVertices));
+        }
+        return result;
+      }
+    }
+  }
+  return [tri];
+};
+
+const solidToMeshBody = (
+  featureId: CadExtrusionFeature["id"],
+  label: string,
+  solid: CsgSolid,
+): CadMeshBody | null => {
+  const initialTriangles: RawTriangle[] = [];
+  const vertexMap = new Map<string, Vec3>();
+
+  for (const polygon of solid.polygons) {
+    if (polygon.vertices.length < 3) continue;
+    const v0 = polygon.vertices[0]!;
+    for (let i = 1; i < polygon.vertices.length - 1; i++) {
+      const v1 = polygon.vertices[i]!;
+      const v2 = polygon.vertices[i + 1]!;
+      const faceCross = cross(sub(v1, v0), sub(v2, v0));
+      const area2 = length(faceCross);
+      if (area2 <= 1e-10) continue;
+      const normal = normalize(faceCross);
+      initialTriangles.push({ v0, v1, v2, normal });
+      for (const vertex of [v0, v1, v2]) {
+        const key = quantizeVertexKey(vertex);
+        if (!vertexMap.has(key)) vertexMap.set(key, vertex);
+      }
+    }
+  }
+
+  if (initialTriangles.length === 0) return null;
+
+  const uniqueVertices = Array.from(vertexMap.values());
+  const triangles = initialTriangles.flatMap((tri) => splitTriangleEdge(tri, uniqueVertices));
+
+  const positions: number[] = [];
+  const normals: number[] = [];
+  const indices: number[] = [];
+  const edgeCounts = new Map<string, number>();
+
+  let signedVolume6 = 0;
+  let surfaceArea = 0;
+  let minX = Infinity;
+  let minY = Infinity;
+  let minZ = Infinity;
+  let maxX = -Infinity;
+  let maxY = -Infinity;
+  let maxZ = -Infinity;
+  let vertexOffset = 0;
+
+  const recordEdge = (a: Vec3, b: Vec3) => {
+    const ka = quantizeVertexKey(a);
+    const kb = quantizeVertexKey(b);
+    if (ka === kb) return;
+    const forward = `${ka}->${kb}`;
+    const reverse = `${kb}->${ka}`;
+    const reverseCount = edgeCounts.get(reverse) ?? 0;
+    if (reverseCount > 0) {
+      edgeCounts.set(reverse, reverseCount - 1);
+      if (reverseCount === 1) edgeCounts.delete(reverse);
+    } else {
+      edgeCounts.set(forward, (edgeCounts.get(forward) ?? 0) + 1);
+    }
+  };
+
+  for (const tri of triangles) {
+    const { v0, v1, v2, normal } = tri;
+    const faceCross = cross(sub(v1, v0), sub(v2, v0));
+    const area2 = length(faceCross);
+    if (area2 <= 1e-10) continue;
+
+    for (const vertex of [v0, v1, v2]) {
+      positions.push(vertex.x, vertex.y, vertex.z);
+      normals.push(normal.x, normal.y, normal.z);
+      if (vertex.x < minX) minX = vertex.x;
+      if (vertex.y < minY) minY = vertex.y;
+      if (vertex.z < minZ) minZ = vertex.z;
+      if (vertex.x > maxX) maxX = vertex.x;
+      if (vertex.y > maxY) maxY = vertex.y;
+      if (vertex.z > maxZ) maxZ = vertex.z;
+    }
+    indices.push(vertexOffset, vertexOffset + 1, vertexOffset + 2);
+    vertexOffset += 3;
+
+    signedVolume6 += dot(v0, cross(v1, v2));
+    surfaceArea += area2 * 0.5;
+
+    recordEdge(v0, v1);
+    recordEdge(v1, v2);
+    recordEdge(v2, v0);
+  }
+
+  const triangleCount = indices.length / 3;
+  if (triangleCount === 0 || !Number.isFinite(minX)) {
+    return null;
+  }
+
+  const volumeMm3 = Math.max(0, signedVolume6 / 6);
+  const watertight = edgeCounts.size === 0;
+
+  return {
+    featureId,
+    label,
+    boundsMm: {
+      min: [roundMetric(minX), roundMetric(minY), roundMetric(minZ)],
+      max: [roundMetric(maxX), roundMetric(maxY), roundMetric(maxZ)],
+    },
+    volumeMm3: roundMetric(volumeMm3),
+    surfaceAreaMm2: roundMetric(surfaceArea),
+    triangleCount,
+    watertight,
+    positions,
+    normals,
+    indices,
+  };
+};
+
+const roundMetric = (value: number): number => Math.round(value * 1e6) / 1e6;
+
+const mergeBounds = (a: CadBoundsMm | null, b: CadBoundsMm): CadBoundsMm => {
+  if (a === null) return b;
+  return {
+    min: [Math.min(a.min[0], b.min[0]), Math.min(a.min[1], b.min[1]), Math.min(a.min[2], b.min[2])],
+    max: [Math.max(a.max[0], b.max[0]), Math.max(a.max[1], b.max[1]), Math.max(a.max[2], b.max[2])],
+  };
+};
+
+export const evaluateCadFeatures = (features: ReadonlyArray<CadFeature>): CadGeometryReport => {
+  const byId = new Map<string, CadFeature>();
+  for (const feature of features) {
+    byId.set(feature.id, feature);
+  }
+
+  const activeBodies: Array<{
+    feature: CadExtrusionFeature;
+    solid: CsgSolid;
+    bounds: CadBoundsMm;
+  }> = [];
+  const warnings: string[] = [];
+
+  for (const feature of features) {
+    if (feature.kind !== "extrusion") continue;
+    const { solid, bounds } = buildSolidForExtrusion(feature, byId);
+    if (feature.operation === "new_body") {
+      activeBodies.push({ feature, solid, bounds });
+      continue;
+    }
+
+    if (feature.targetBodyId !== undefined) {
+      const target = activeBodies.find((entry) => entry.feature.id === feature.targetBodyId);
+      if (!target) {
+        warnings.push(
+          `Operation '${feature.operation}' extrusion '${feature.id}' target body '${feature.targetBodyId}' was not found.`,
+        );
+        continue;
+      }
+      if (feature.operation === "union") {
+        target.solid = target.solid.union(solid);
+        target.bounds = mergeBounds(target.bounds, bounds);
+      } else if (feature.operation === "cut") {
+        if (!boundsOverlap(target.bounds, bounds)) {
+          warnings.push(
+            `Cut extrusion '${feature.id}' does not intersect target body '${target.feature.id}'.`,
+          );
+        } else {
+          target.solid = target.solid.subtract(solid);
+        }
+      } else {
+        if (!boundsOverlap(target.bounds, bounds)) {
+          target.solid = new CsgSolid([]);
+          warnings.push(
+            `Intersect extrusion '${feature.id}' does not overlap target body '${target.feature.id}'.`,
+          );
+        } else {
+          target.solid = target.solid.intersect(solid);
+          target.bounds = intersectBounds(target.bounds, bounds);
+        }
+      }
+      continue;
+    }
+
+    if (feature.operation === "union") {
+      if (activeBodies.length === 0) {
+        warnings.push(
+          `Union extrusion '${feature.id}' had no existing body to merge into; created a new body.`,
+        );
+        activeBodies.push({ feature, solid, bounds });
+      } else {
+        const overlapping = activeBodies.find((entry) => boundsOverlap(entry.bounds, bounds));
+        const target = overlapping ?? activeBodies[0]!;
+        target.solid = target.solid.union(solid);
+        target.bounds = mergeBounds(target.bounds, bounds);
+      }
+      continue;
+    }
+
+    if (feature.operation === "intersect") {
+      let overlappedAny = false;
+      for (const target of activeBodies) {
+        if (!boundsOverlap(target.bounds, bounds)) {
+          target.solid = new CsgSolid([]);
+        } else {
+          overlappedAny = true;
+          target.solid = target.solid.intersect(solid);
+          target.bounds = intersectBounds(target.bounds, bounds);
+        }
+      }
+      if (!overlappedAny) {
+        warnings.push(
+          `Intersect extrusion '${feature.id}' does not overlap any existing solid body.`,
+        );
+      }
+      continue;
+    }
+
+    let intersectedAny = false;
+    for (let i = 0; i < activeBodies.length; i++) {
+      const target = activeBodies[i]!;
+      if (!boundsOverlap(target.bounds, bounds)) continue;
+      intersectedAny = true;
+      target.solid = target.solid.subtract(solid);
+    }
+    if (!intersectedAny) {
+      warnings.push(`Cut extrusion '${feature.id}' does not intersect any existing solid body.`);
+    }
+  }
+
+  const bodies: CadMeshBody[] = [];
+  let totalVolumeMm3 = 0;
+  let totalSurfaceAreaMm2 = 0;
+  let allBounds: CadBoundsMm | null = null;
+  let allWatertight = true;
+
+  for (const entry of activeBodies) {
+    const mesh = solidToMeshBody(
+      entry.feature.id,
+      entry.feature.name ?? entry.feature.id,
+      entry.solid,
+    );
+    if (mesh === null || mesh.volumeMm3 <= 1e-6) {
+      warnings.push(
+        `Body '${entry.feature.id}' was completely removed or produced empty geometry.`,
+      );
+      continue;
+    }
+    bodies.push(mesh);
+    totalVolumeMm3 += mesh.volumeMm3;
+    totalSurfaceAreaMm2 += mesh.surfaceAreaMm2;
+    allBounds = mergeBounds(allBounds, mesh.boundsMm);
+    if (!mesh.watertight) allWatertight = false;
+  }
+
+  const status = bodies.length === 0 ? "empty" : "valid";
+
+  return {
+    engine: "t3cad-csg-kernel",
+    status,
+    watertight: bodies.length > 0 && allWatertight,
+    totalVolumeMm3: roundMetric(totalVolumeMm3),
+    totalSurfaceAreaMm2: roundMetric(totalSurfaceAreaMm2),
+    boundsMm: allBounds,
+    bodies,
+    warnings,
+    limitations: [
+      `Multi-plane extruded solid and CSG mesh kernel (${CIRCLE_SEGMENTS}-segment circular profiles).`,
+      "Supports XY (+Z), XZ (+Y), and YZ (+X) sketch planes, simple polygons, and new_body/union/cut/intersect booleans.",
+      "No fillets, chamfers, STEP/IGES B-rep export, or FEA/tolerance checks.",
+    ],
+  };
+};
+
+export const generateAsciiStl = (
+  documentName: string,
+  report: CadGeometryReport,
+): { readonly stlAscii: string; readonly triangleCount: number } => {
+  const safeName = documentName.replace(/[^A-Za-z0-9_-]+/g, "_") || "t3cad_part";
+  const lines: string[] = [`solid ${safeName}`];
+  let triangleCount = 0;
+
+  for (const body of report.bodies) {
+    const { positions, normals, indices } = body;
+    for (let i = 0; i < indices.length; i += 3) {
+      const i0 = indices[i]! * 3;
+      const i1 = indices[i + 1]! * 3;
+      const i2 = indices[i + 2]! * 3;
+      const nx = normals[i0] ?? 0;
+      const ny = normals[i0 + 1] ?? 0;
+      const nz = normals[i0 + 2] ?? 1;
+      lines.push(
+        `  facet normal ${nx} ${ny} ${nz}`,
+        "    outer loop",
+        `      vertex ${positions[i0]} ${positions[i0 + 1]} ${positions[i0 + 2]}`,
+        `      vertex ${positions[i1]} ${positions[i1 + 1]} ${positions[i1 + 2]}`,
+        `      vertex ${positions[i2]} ${positions[i2 + 1]} ${positions[i2 + 2]}`,
+        "    endloop",
+        "  endfacet",
+      );
+      triangleCount += 1;
+    }
+  }
+
+  lines.push(`endsolid ${safeName}`);
+  return { stlAscii: `${lines.join("\n")}\n`, triangleCount };
+};
