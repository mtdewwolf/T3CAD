+                  <div className="flex justify-end gap-1.5">
+                    <Button size="micro" variant="ghost" onClick={() => setShowAddFeature(false)}>
+                      Cancel
+                    </Button>
+                    <Button
+                      size="micro"
+                      disabled={busyAction !== null}
+                      onClick={() => void handleAddCustomFeature()}
+                    >
+                      Add Feature
+                    </Button>
+                  </div>
+                </div>
+              ) : null}
+
+              <div className="max-h-56 divide-y divide-border/60 overflow-y-auto">
+                {snapshot.features.map((feature) => {
+                  const selected = activeFeature?.id === feature.id;
+                  return (
+                    <button
+                      key={feature.id}
+                      type="button"
+                      onClick={() => setSelectedFeatureId(feature.id)}
+                      className={cn(
+                        "flex w-full items-center justify-between gap-2 px-2.5 py-1.5 text-left text-xs transition-colors hover:bg-accent/50",
+                        selected && "bg-accent text-foreground",
+                      )}
+                    >
+                      <span className="flex min-w-0 items-center gap-1.5">
+                        {feature.kind === "rectangle" ? (
+                          <SquareIcon className="size-3 shrink-0 text-info" />
+                        ) : feature.kind === "circle" ? (
+                          <CircleIcon className="size-3 shrink-0 text-success" />
+                        ) : feature.kind === "polygon" ? (
+                          <HexagonIcon className="size-3 shrink-0 text-accent-foreground" />
+                        ) : (
+                          <LayersIcon className="size-3 shrink-0 text-warning" />
+                        )}
+                        <span className="truncate font-medium">{feature.name ?? feature.id}</span>
+                      </span>
+                      <span className="shrink-0 font-mono text-3xs text-muted-foreground">
+                        {feature.kind === "extrusion"
+                          ? feature.operation
+                          : `${feature.kind}${feature.plane && feature.plane !== "xy" ? `:${feature.plane}` : ""}`}
+                      </span>
+                    </button>
+                  );
+                })}
+              </div>
+            </div>
+
+            <div className="flex flex-col rounded-md border border-border bg-card">
+              <div className="flex items-center justify-between border-b border-border px-2.5 py-1.5">
+                <span className="font-medium text-xs text-foreground">
+                  Parameters {activeFeature ? `· ${activeFeature.id}` : ""}
+                </span>
+                {activeFeature !== null ? (
+                  <Button
+                    size="icon-tiny"
+                    variant="ghost-destructive"
+                    title={`Delete ${activeFeature.id}`}
+                    disabled={busyAction !== null}
+                    onClick={() => void handleDeleteFeature(activeFeature.id)}
+                  >
+                    <Trash2Icon className="size-3" />
+                  </Button>
+                ) : null}
+              </div>
+
+              {activeFeature === null ? (
+                <div className="p-3 text-xs text-muted-foreground">
+                  Select a sketch or extrusion feature to inspect and edit parameters.
+                </div>
+              ) : (
+                <div className="space-y-2 p-2.5 text-xs">
+                  <label className="flex flex-col gap-1">
+                    <span className="text-2xs text-muted-foreground">Feature Name</span>
+                    <input
+                      aria-label="Feature Name"
+                      className="h-7 rounded-md border border-input bg-background px-2 text-xs"
+                      value={activeDraft?.name ?? activeFeature.name ?? activeFeature.id}
+                      onChange={(event) =>
+                        setDraftEdits({
+                          scopeKey: editScopeKey,
+                          name: event.target.value,
+                          values: activeDraft?.values ?? {},
+                        })
+                      }
+                      onKeyDown={(event) => {
+                        if (event.key === "Enter") void handleApplyFeatureEdits();
+                      }}
+                    />
+                  </label>
+                  {activeFeature.kind === "polygon" ? (
+                    <div className="rounded-md border border-border/70 bg-muted/30 p-2 font-mono text-2xs text-muted-foreground">
+                      <div>
+                        Plane {(activeFeature.plane ?? "xy").toUpperCase()} ·{" "}
+                        {activeFeature.points.length} vertices
+                      </div>
+                      <div className="mt-1 truncate">
+                        {activeFeature.points.map(([px, py]) => `(${px}, ${py})`).join(" → ")}
+                      </div>
+                    </div>
+                  ) : (
+                    <div className="grid grid-cols-2 gap-2">
+                      {featureParameters(activeFeature).map((param) => (
+                        <label key={param.key} className="flex flex-col gap-1">
+                          <span className="text-2xs text-muted-foreground">{param.label}</span>
+                          <input
+                            type="number"
+                            step="any"
+                            aria-label={param.label}
+                            className="h-7 rounded-md border border-input bg-background px-2 font-mono text-xs"
+                            value={activeDraft?.values[param.key] ?? String(param.value)}
+                            onChange={(event) =>
+                              setDraftEdits({
+                                scopeKey: editScopeKey,
+                                name: activeDraft?.name ?? activeFeature.name ?? activeFeature.id,
+                                values: {
+                                  ...activeDraft?.values,
+                                  [param.key]: event.target.value,
+                                },
+                              })
+                            }
+                            onKeyDown={(event) => {
+                              if (event.key === "Enter") void handleApplyFeatureEdits();
+                            }}
+                          />
+                        </label>
+                      ))}
+                    </div>
+                  )}
+                  <div className="flex items-center justify-between pt-1">
+                    <span className="font-mono text-3xs text-muted-foreground">
+                      rev {snapshot.revision}
+                    </span>
+                    <Button
+                      size="xs"
+                      disabled={!dirtyEdits || busyAction !== null}
+                      onClick={() => void handleApplyFeatureEdits()}
+                    >
+                      Apply Edit
+                    </Button>
+                  </div>
+                </div>
+              )}
+            </div>
+          </div>
+
+          <div className="px-2.5 pb-3">
+            <div className="rounded-md border border-border bg-card">
+              <div className="border-b border-border px-2.5 py-1.5 font-medium text-xs text-foreground">
+                Command Provenance ({snapshot.history.length})
+              </div>
+              <div className="max-h-40 divide-y divide-border/60 overflow-y-auto">
+                {[...snapshot.history].reverse().map((entry) => (
+                  <div
+                    key={`${entry.revision}:${entry.requestId}`}
+                    className="flex items-start justify-between gap-2 px-2.5 py-1.5 text-xs"
+                  >
+                    <div className="min-w-0 flex-1 space-y-0.5">
+                      <div className="flex items-center gap-1.5">
+                        <span className="rounded bg-muted px-1 py-0.5 font-mono text-3xs font-medium">
+                          r{entry.revision}
+                        </span>
+                        <span
+                          className={cn(
+                            "inline-flex items-center gap-1 rounded px-1.5 py-0.5 text-3xs font-medium",
+                            entry.actor.kind === "agent"
+                              ? "bg-info/15 text-info"
+                              : "bg-success/15 text-success",
+                          )}
+                        >
+                          {entry.actor.kind === "agent" ? (
+                            <BotIcon className="size-2.5" />
+                          ) : (
+                            <UserIcon className="size-2.5" />
+                          )}
+                          {entry.actor.label ?? entry.actor.kind}
+                        </span>
+                      </div>
+                      <div className="truncate font-mono text-2xs text-muted-foreground">
+                        {entry.summary.join("; ")}
+                      </div>
+                    </div>
+                    {entry.revision < snapshot.revision ? (
+                      <Button
+                        size="micro"
+                        variant="ghost"
+                        title={`Restore r${entry.revision}`}
+                        disabled={busyAction !== null}
+                        onClick={() => void handleRestoreRevision(entry.revision)}
+                      >
+                        <Undo2Icon className="size-3" />
+                        Restore
+                      </Button>
+                    ) : null}
+                  </div>
+                ))}
+              </div>
+            </div>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
