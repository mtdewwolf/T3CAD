diff --git a/apps/web/src/state/cad.ts b/apps/web/src/state/cad.ts
new file mode 100644
index 00000000..51fd705b
--- /dev/null
+++ b/apps/web/src/state/cad.ts
@@ -0,0 +1,74 @@
+import {
+  createAtomCommandScheduler,
+  createEnvironmentRpcCommand,
+  createEnvironmentRpcQueryAtomFamily,
+  createEnvironmentRpcSubscriptionAtomFamily,
+} from "@t3tools/client-runtime/state/runtime";
+import { WS_METHODS } from "@t3tools/contracts";
+import * as Stream from "effect/Stream";
+
+import { connectionAtomRuntime } from "../connection/runtime";
+
+const cadMutationScheduler = createAtomCommandScheduler();
+const cadDocumentConcurrency = {
+  mode: "serial" as const,
+  key: ({
+    environmentId,
+    input,
+  }: {
+    readonly environmentId: string;
+    readonly input: { readonly projectId: string; readonly documentId: string };
+  }) => JSON.stringify([environmentId, input.projectId, input.documentId]),
+};
+
+export const cadEnvironment = {
+  capabilities: createEnvironmentRpcQueryAtomFamily(connectionAtomRuntime, {
+    label: "environment-data:cad:capabilities",
+    tag: WS_METHODS.cadCapabilities,
+    staleTimeMs: 60_000,
+  }),
+  listDocuments: createEnvironmentRpcQueryAtomFamily(connectionAtomRuntime, {
+    label: "environment-data:cad:list",
+    tag: WS_METHODS.cadListDocuments,
+    staleTimeMs: 2_000,
+  }),
+  inspectDocument: createEnvironmentRpcQueryAtomFamily(connectionAtomRuntime, {
+    label: "environment-data:cad:inspect",
+    tag: WS_METHODS.cadInspect,
+    staleTimeMs: 1_000,
+  }),
+  documentStream: createEnvironmentRpcSubscriptionAtomFamily(connectionAtomRuntime, {
+    label: "environment-data:cad:subscribe",
+    tag: WS_METHODS.cadSubscribeDocument,
+    transform: (stream) => stream.pipe(Stream.rechunk(1)),
+  }),
+  projectStream: createEnvironmentRpcSubscriptionAtomFamily(connectionAtomRuntime, {
+    label: "environment-data:cad:subscribe-project",
+    tag: WS_METHODS.cadSubscribeProject,
+    transform: (stream) => stream.pipe(Stream.rechunk(1)),
+  }),
+  createDocument: createEnvironmentRpcCommand(connectionAtomRuntime, {
+    label: "environment-data:cad:create",
+    tag: WS_METHODS.cadCreateDocument,
+    scheduler: cadMutationScheduler,
+    concurrency: cadDocumentConcurrency,
+  }),
+  applyCommands: createEnvironmentRpcCommand(connectionAtomRuntime, {
+    label: "environment-data:cad:apply",
+    tag: WS_METHODS.cadApply,
+    scheduler: cadMutationScheduler,
+    concurrency: cadDocumentConcurrency,
+  }),
+  restoreRevision: createEnvironmentRpcCommand(connectionAtomRuntime, {
+    label: "environment-data:cad:restore",
+    tag: WS_METHODS.cadRestoreRevision,
+    scheduler: cadMutationScheduler,
+    concurrency: cadDocumentConcurrency,
+  }),
+  exportStl: createEnvironmentRpcCommand(connectionAtomRuntime, {
+    label: "environment-data:cad:export-stl",
+    tag: WS_METHODS.cadExportStl,
+    scheduler: cadMutationScheduler,
+    concurrency: cadDocumentConcurrency,
+  }),
+};
