+const applyCadRestoreRevision = (
+  persisted: PersistedCadDocument,
+  input: {
+    readonly requestId: CadRequestId;
+    readonly expectedRevision: number;
+    readonly targetRevision: number;
+    readonly actor: CadActor;
+    readonly timestamp: IsoDateTime;
+  },
+):
+  | {
+      readonly persisted: PersistedCadDocument;
+      readonly result: CadApplyResult;
+    }
+  | CadDomainError => {
+  const { snapshot } = persisted;
+  const requestDigest = computeCadRestoreDigest({
+    expectedRevision: input.expectedRevision,
+    targetRevision: input.targetRevision,
+    actor: input.actor,
+  });
+
+  const previousRequest = persisted.idempotency.find(
+    (entry) => entry.requestId === input.requestId,
+  );
+  if (previousRequest) {
+    if (previousRequest.requestDigest !== requestDigest) {
+      return new CadRequestIdConflictError({ requestId: input.requestId });
+    }
+    return {
+      persisted,
+      result: {
+        requestId: input.requestId,
+        documentId: snapshot.documentId,
+        revision: NonNegativeInt.make(previousRequest.revision),
+        replayed: true,
+        snapshot,
+      },
+    };
+  }
+
+  if (snapshot.revision !== input.expectedRevision) {
+    return new CadRevisionConflictError({
+      expectedRevision: NonNegativeInt.make(input.expectedRevision),
+      actualRevision: snapshot.revision,
+    });
+  }
+
+  const checkpoint = existingCheckpointsFor(persisted).find(
+    (entry) => entry.revision === input.targetRevision,
+  );
+  if (!checkpoint) {
+    return new CadInvalidInputError({
+      detail: `Revision checkpoint r${input.targetRevision} is not available for '${snapshot.documentId}'.`,
+    });
+  }
+
+  const restoredFeatures = [...checkpoint.features];
+  const report = evaluateCadFeatures(restoredFeatures);
+  const nextRevision = NonNegativeInt.make(snapshot.revision + 1);
+  const historyEntry: CadHistoryEntry = {
+    revision: nextRevision,
+    timestamp: input.timestamp,
+    requestId: input.requestId,
+    actor: input.actor,
+    commandCount: PositiveInt.make(1),
+    summary: [`Restored feature state from r${input.targetRevision}`],
+    requestDigest,
+  };
+
+  const nextSnapshot: CadDocumentSnapshot = {
+    ...snapshot,
+    revision: nextRevision,
+    updatedAt: input.timestamp,
+    features: restoredFeatures,
+    report,
+    history: [...snapshot.history, historyEntry].slice(-MAX_HISTORY_ENTRIES),
+  };
+
+  const nextIdempotency: IdempotencyRecord[] = [
+    ...persisted.idempotency,
+    { requestId: input.requestId, requestDigest, revision: nextRevision },
+  ].slice(-MAX_IDEMPOTENCY_ENTRIES);
+
+  const nextCheckpoints: RevisionCheckpoint[] = [
+    ...existingCheckpointsFor(persisted),
+    { revision: nextRevision, features: restoredFeatures },
+  ].slice(-MAX_CHECKPOINT_ENTRIES);
+
+  const nextPersisted: PersistedCadDocument = {
+    snapshot: nextSnapshot,
+    idempotency: nextIdempotency,
+    checkpoints: nextCheckpoints,
+  };
+
+  return {
+    persisted: nextPersisted,
+    result: {
+      requestId: input.requestId,
+      documentId: nextSnapshot.documentId,
+      revision: nextRevision,
+      replayed: false,
+      snapshot: nextSnapshot,
+    },
+  };
+};
+
+interface DocumentBusEvent {
+  readonly projectId: ProjectId;
+  readonly documentId: CadDocumentId;
+  readonly event: CadDocumentEvent;
+}
+
+export class CadDocumentService extends Context.Service<
+  CadDocumentService,
+  {
+    readonly capabilities: () => CadCapabilities;
+    readonly listDocuments: (
+      input: CadListDocumentsInput,
+    ) => Effect.Effect<CadListDocumentsResult, CadDomainError>;
+    readonly createDocument: (
+      input: CadCreateDocumentInput,
+    ) => Effect.Effect<CadDocumentSnapshot, CadDomainError>;
+    readonly inspectDocument: (
+      input: CadInspectInput,
+    ) => Effect.Effect<CadDocumentSnapshot, CadDomainError>;
+    readonly applyCommands: (input: CadApplyInput) => Effect.Effect<CadApplyResult, CadDomainError>;
+    readonly restoreRevision: (
+      input: CadRestoreRevisionInput,
+    ) => Effect.Effect<CadApplyResult, CadDomainError>;
+    readonly exportStl: (
+      input: CadExportStlInput,
+    ) => Effect.Effect<CadExportStlResult, CadDomainError>;
+    readonly subscribeDocument: (
+      input: CadSubscribeDocumentInput,
+    ) => Stream.Stream<CadDocumentEvent, CadDomainError>;
+    readonly subscribeProject: (
+      input: CadSubscribeProjectInput,
+    ) => Stream.Stream<CadProjectEvent, CadDomainError>;
+  }
+>()("t3/cad/CadDocumentService") {}
+
+const make = Effect.gen(function* () {
+  const fileSystem = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const projectService = yield* ProjectService.ProjectService;
+  const workspacePaths = yield* WorkspacePaths.WorkspacePaths;
+  const locks = yield* KeyedLock.make<string>();
+  const eventsPubSub = yield* PubSub.unbounded<DocumentBusEvent>();
+
+  const persistedJsonSchema = Schema.fromJsonString(PersistedCadDocumentSchema);
+  const decodePersistedJson = Schema.decodeEffect(persistedJsonSchema);
+  const encodePersistedJson = Schema.encodeEffect(persistedJsonSchema);
+
+  const resolveProjectRoot = Effect.fn("CadDocumentService.resolveProjectRoot")(function* (
+    projectId: ProjectId,
+  ) {
+    const projectOption = yield* projectService.getById(projectId).pipe(
+      Effect.mapError(
+        (cause) =>
+          new CadStorageError({
+            detail: `Failed to resolve project '${projectId}': ${cause.message}`,
+          }),
+      ),
+    );
+    if (Option.isNone(projectOption)) {
+      return yield* new CadInvalidInputError({
+        detail: `Project '${projectId}' was not found.`,
+      });
+    }
+    return projectOption.value.workspaceRoot;
+  });
+
+  const resolveCadDirectory = Effect.fn("CadDocumentService.resolveCadDirectory")(function* (
+    workspaceRoot: string,
+  ) {
+    const resolved = yield* workspacePaths
+      .resolveRelativePathWithinRoot({
+        workspaceRoot,
+        relativePath: CAD_DIR_NAME,
+      })
+      .pipe(
+        Effect.mapError(
+          (cause) =>
+            new CadInvalidInputError({
+              detail: cause.message,
+            }),
+        ),
+      );
+    return resolved.absolutePath;
+  });
+
+  const resolveDocumentPath = Effect.fn("CadDocumentService.resolveDocumentPath")(function* (
+    workspaceRoot: string,
+    documentId: CadDocumentId,
+  ) {
+    const relativePath = `${CAD_DIR_NAME}/${documentId}${CAD_FILE_EXTENSION}`;
+    const resolved = yield* workspacePaths
+      .resolveRelativePathWithinRoot({
+        workspaceRoot,
+        relativePath,
+      })
+      .pipe(
+        Effect.mapError(
+          (cause) =>
+            new CadInvalidInputError({
+              detail: cause.message,
+            }),
+        ),
+      );
+    return resolved.absolutePath;
+  });
+
+  const readPersistedFile = Effect.fn("CadDocumentService.readPersistedFile")(function* (
+    filePath: string,
+    documentId: CadDocumentId,
+  ) {
+    const exists = yield* fileSystem.exists(filePath).pipe(
+      Effect.mapError(
+        (cause) =>
+          new CadStorageError({
+            detail: `Failed to check CAD document '${documentId}': ${String(cause)}`,
+          }),
+      ),
+    );
+    if (!exists) {
+      return yield* new CadDocumentNotFoundError({ documentId });
+    }
+    const raw = yield* fileSystem.readFileString(filePath).pipe(
+      Effect.mapError(
+        (cause) =>
+          new CadStorageError({
+            detail: `Failed to read CAD document '${documentId}': ${String(cause)}`,
+          }),
+      ),
+    );
+    return yield* decodePersistedJson(raw).pipe(
+      Effect.mapError(
+        (cause) =>
+          new CadStorageError({
+            detail: `CAD document '${documentId}' failed validation: ${cause.message}`,
+          }),
+      ),
+    );
+  });
+
+  const writePersistedFile = Effect.fn("CadDocumentService.writePersistedFile")(function* (
+    workspaceRoot: string,
+    filePath: string,
+    persisted: PersistedCadDocument,
+  ) {
+    const cadDir = yield* resolveCadDirectory(workspaceRoot);
+    yield* fileSystem.makeDirectory(cadDir, { recursive: true }).pipe(
+      Effect.mapError(
+        (cause) =>
+          new CadStorageError({
+            detail: `Failed to prepare CAD directory: ${String(cause)}`,
+          }),
+      ),
+    );
+    const tempPath = path.join(
+      cadDir,
+      `.tmp-${persisted.snapshot.documentId}-${NodeCrypto.randomUUID()}.json`,
+    );
+    const serialized = yield* encodePersistedJson(persisted).pipe(
+      Effect.map((text) => `${text}\n`),
+      Effect.mapError(
+        (cause) =>
+          new CadStorageError({
+            detail: `Failed to serialize CAD document: ${cause.message}`,
+          }),
+      ),
+    );
+    yield* fileSystem.writeFileString(tempPath, serialized).pipe(
+      Effect.mapError(
+        (cause) =>
+          new CadStorageError({
+            detail: `Failed to write CAD temp file: ${String(cause)}`,
+          }),
+      ),
+    );
+    yield* fileSystem.rename(tempPath, filePath).pipe(
+      Effect.mapError(
+        (cause) =>
+          new CadStorageError({
+            detail: `Failed to commit CAD document write: ${String(cause)}`,
+          }),
+      ),
+    );
+  });
+
+  const toSummary = (snapshot: CadDocumentSnapshot): CadDocumentSummary => ({
+    documentId: snapshot.documentId,
+    name: snapshot.name,
+    units: snapshot.units,
+    revision: snapshot.revision,
+    featureCount: NonNegativeInt.make(snapshot.features.length),
+    totalVolumeMm3: snapshot.report.totalVolumeMm3,
+    status: snapshot.report.status,
+    updatedAt: snapshot.updatedAt,
+  });
+
+  const lockKey = (projectId: ProjectId, documentId: CadDocumentId) => `${projectId}:${documentId}`;
+
+  const listDocuments: CadDocumentService["Service"]["listDocuments"] = Effect.fn(
+    "CadDocumentService.listDocuments",
+  )(function* (input) {
+    const workspaceRoot = yield* resolveProjectRoot(input.projectId);
+    const cadDir = yield* resolveCadDirectory(workspaceRoot);
+    const exists = yield* fileSystem.exists(cadDir).pipe(
+      Effect.mapError(
+        (cause) =>
+          new CadStorageError({
+            detail: `Failed to inspect CAD directory: ${String(cause)}`,
+          }),
+      ),
+    );
+    if (!exists) {
+      return { projectId: input.projectId, documents: [] };
+    }
+    const entries = yield* fileSystem.readDirectory(cadDir).pipe(
+      Effect.mapError(
+        (cause) =>
+          new CadStorageError({
+            detail: `Failed to list CAD documents: ${String(cause)}`,
+          }),
+      ),
+    );
+
+    const summaries: CadDocumentSummary[] = [];
+    for (const entry of entries) {
+      if (!entry.endsWith(CAD_FILE_EXTENSION) || entry.startsWith(".")) continue;
+      const docIdRaw = entry.slice(0, -CAD_FILE_EXTENSION.length);
+      const docIdParsed = decodeCadDocumentIdOption(docIdRaw);
+      if (Option.isNone(docIdParsed)) continue;
+      const filePath = path.join(cadDir, entry);
+      const persisted = yield* readPersistedFile(filePath, docIdParsed.value);
+      summaries.push(toSummary(persisted.snapshot));
+    }
+    summaries.sort((left, right) => right.updatedAt.localeCompare(left.updatedAt));
+    return { projectId: input.projectId, documents: summaries };
+  });
+
+  const createDocument: CadDocumentService["Service"]["createDocument"] = Effect.fn(
+    "CadDocumentService.createDocument",
+  )(function* (input) {
+    return yield* locks.withLock(
+      lockKey(input.projectId, input.documentId),
+      Effect.gen(function* () {
+        const workspaceRoot = yield* resolveProjectRoot(input.projectId);
+        const filePath = yield* resolveDocumentPath(workspaceRoot, input.documentId);
+        const exists = yield* fileSystem.exists(filePath).pipe(
+          Effect.mapError(
+            (cause) =>
+              new CadStorageError({
+                detail: `Failed to check existing CAD document '${input.documentId}': ${String(cause)}`,
+              }),
+          ),
+        );
+        if (exists) {
+          return yield* new CadDocumentAlreadyExistsError({ documentId: input.documentId });
+        }
+
+        const now = IsoDateTime.make(DateTime.formatIso(yield* DateTime.now));
+        const baseSnapshot: CadDocumentSnapshot = {
+          schemaVersion: CAD_SCHEMA_VERSION,
+          documentId: input.documentId,
+          name: input.name ?? input.documentId,
+          units: CAD_UNITS,
+          revision: NonNegativeInt.make(0),
+          updatedAt: now,
+          features: [],
+          report: evaluateCadFeatures([]),
+          history: [],
+        };
+
+        let persisted: PersistedCadDocument = {
+          snapshot: baseSnapshot,
+          idempotency: [],
+          checkpoints: [{ revision: NonNegativeInt.make(0), features: [] }],
+        };
+
+        if (input.preset === "mounting_plate" || input.preset === "l_bracket") {
+          const isBracket = input.preset === "l_bracket";
+          const outcome = applyCadCommands(persisted, {
+            requestId: CadRequestId.make(`init:${input.documentId}`),
+            expectedRevision: 0,
+            actor: input.actor ?? {
+              kind: "user",
+              id: "preset",
+              label: isBracket ? "3D L-Bracket Preset" : "Mounting Plate Preset",
+            },
+            commands: isBracket
+              ? buildLBracketPresetCommands()
+              : buildMountingPlatePresetCommands(),
+            timestamp: now,
+          });
+          if (!("persisted" in outcome)) {
+            return yield* outcome;
+          }
+          persisted = outcome.persisted;
+        }
+
+        yield* writePersistedFile(workspaceRoot, filePath, persisted);
+        yield* PubSub.publish(eventsPubSub, {
+          projectId: input.projectId,
+          documentId: input.documentId,
+          event: { _tag: "snapshot", snapshot: persisted.snapshot },
+        });
+        return persisted.snapshot;
+      }),
+    );
+  });
+
+  const inspectDocument: CadDocumentService["Service"]["inspectDocument"] = Effect.fn(
+    "CadDocumentService.inspectDocument",
+  )(function* (input) {
+    const workspaceRoot = yield* resolveProjectRoot(input.projectId);
+    const filePath = yield* resolveDocumentPath(workspaceRoot, input.documentId);
+    const persisted = yield* readPersistedFile(filePath, input.documentId);
+    return persisted.snapshot;
+  });
+
+  const applyCommands: CadDocumentService["Service"]["applyCommands"] = Effect.fn(
+    "CadDocumentService.applyCommands",
+  )(function* (input) {
+    return yield* locks.withLock(
+      lockKey(input.projectId, input.documentId),
+      Effect.gen(function* () {
+        const workspaceRoot = yield* resolveProjectRoot(input.projectId);
+        const filePath = yield* resolveDocumentPath(workspaceRoot, input.documentId);
+        const current = yield* readPersistedFile(filePath, input.documentId);
+        const now = IsoDateTime.make(DateTime.formatIso(yield* DateTime.now));
+
+        const outcome = applyCadCommands(current, {
+          requestId: input.requestId,
+          expectedRevision: input.expectedRevision,
+          actor: input.actor,
+          commands: input.commands,
+          timestamp: now,
+        });
+
+        if (!("persisted" in outcome)) {
+          return yield* outcome;
+        }
+
+        if (!outcome.result.replayed) {
+          yield* writePersistedFile(workspaceRoot, filePath, outcome.persisted);
+          yield* PubSub.publish(eventsPubSub, {
+            projectId: input.projectId,
+            documentId: input.documentId,
+            event: { _tag: "snapshot", snapshot: outcome.result.snapshot },
+          });
+        }
+
+        return outcome.result;
+      }),
+    );
+  });
+
+  const restoreRevision: CadDocumentService["Service"]["restoreRevision"] = Effect.fn(
+    "CadDocumentService.restoreRevision",
+  )(function* (input) {
+    return yield* locks.withLock(
+      lockKey(input.projectId, input.documentId),
+      Effect.gen(function* () {
+        const workspaceRoot = yield* resolveProjectRoot(input.projectId);
+        const filePath = yield* resolveDocumentPath(workspaceRoot, input.documentId);
+        const current = yield* readPersistedFile(filePath, input.documentId);
+        const now = IsoDateTime.make(DateTime.formatIso(yield* DateTime.now));
+
+        const outcome = applyCadRestoreRevision(current, {
+          requestId: input.requestId,
+          expectedRevision: input.expectedRevision,
+          targetRevision: input.targetRevision,
+          actor: input.actor,
+          timestamp: now,
+        });
+
+        if (!("persisted" in outcome)) {
+          return yield* outcome;
+        }
+
+        if (!outcome.result.replayed) {
+          yield* writePersistedFile(workspaceRoot, filePath, outcome.persisted);
+          yield* PubSub.publish(eventsPubSub, {
+            projectId: input.projectId,
+            documentId: input.documentId,
+            event: { _tag: "snapshot", snapshot: outcome.result.snapshot },
+          });
+        }
+
+        return outcome.result;
+      }),
+    );
+  });
+
+  const exportStl: CadDocumentService["Service"]["exportStl"] = Effect.fn(
+    "CadDocumentService.exportStl",
+  )(function* (input) {
+    const workspaceRoot = yield* resolveProjectRoot(input.projectId);
+    const filePath = yield* resolveDocumentPath(workspaceRoot, input.documentId);
+    const persisted = yield* readPersistedFile(filePath, input.documentId);
+    const { snapshot } = persisted;
+    const { stlAscii, triangleCount } = generateAsciiStl(snapshot.name, snapshot.report);
+    const filename = `${snapshot.documentId}-r${snapshot.revision}.stl`;
+    let writtenPath: string | null = null;
+
+    if (input.relativePath !== undefined) {
+      const resolvedOutput = yield* workspacePaths
+        .resolveRelativePathWithinRoot({
+          workspaceRoot,
+          relativePath: input.relativePath,
+        })
+        .pipe(
+          Effect.mapError(
+            (cause) =>
+              new CadInvalidInputError({
+                detail: cause.message,
+              }),
+          ),
+        );
+      const parentDir = path.dirname(resolvedOutput.absolutePath);
+      yield* fileSystem.makeDirectory(parentDir, { recursive: true }).pipe(
+        Effect.mapError(
+          (cause) =>
+            new CadStorageError({
+              detail: `Failed to prepare STL output directory: ${String(cause)}`,
+            }),
+        ),
+      );
+      yield* fileSystem.writeFileString(resolvedOutput.absolutePath, stlAscii).pipe(
+        Effect.mapError(
+          (cause) =>
+            new CadStorageError({
+              detail: `Failed to write STL file '${resolvedOutput.relativePath}': ${String(cause)}`,
+            }),
+        ),
+      );
+      writtenPath = resolvedOutput.relativePath;
+    }
+
+    return {
+      documentId: snapshot.documentId,
+      revision: snapshot.revision,
+      filename,
+      writtenPath,
+      triangleCount: NonNegativeInt.make(triangleCount),
+      byteLength: NonNegativeInt.make(Buffer.byteLength(stlAscii, "utf8")),
+      stlAscii,
+    };
+  });
+
+  const subscribeDocument: CadDocumentService["Service"]["subscribeDocument"] = (input) =>
+    Stream.unwrap(
+      Effect.gen(function* () {
+        const subscription = yield* PubSub.subscribe(eventsPubSub);
+        const initialSnapshot = yield* inspectDocument(input);
+        const liveUpdates = Stream.fromSubscription(subscription).pipe(
+          Stream.filter(
+            (item) => item.projectId === input.projectId && item.documentId === input.documentId,
+          ),
+          Stream.map((item) => item.event),
+        );
+        const initialEvent: CadDocumentEvent = {
+          _tag: "snapshot",
+          snapshot: initialSnapshot,
+        };
+        return Stream.concat(Stream.succeed(initialEvent), liveUpdates);
+      }),
+    );
+
+  const subscribeProject: CadDocumentService["Service"]["subscribeProject"] = (input) =>
+    Stream.unwrap(
+      Effect.gen(function* () {
+        const subscription = yield* PubSub.subscribe(eventsPubSub);
+        const initial = yield* listDocuments({ projectId: input.projectId });
+        const liveUpdates = Stream.fromSubscription(subscription).pipe(
+          Stream.filter((item) => item.projectId === input.projectId),
+          Stream.mapEffect(() => listDocuments({ projectId: input.projectId })),
+        );
+        return Stream.concat(Stream.succeed(initial), liveUpdates);
+      }),
+    );
+
+  return CadDocumentService.of({
+    capabilities: () => CAD_CAPABILITIES,
+    listDocuments,
+    createDocument,
+    inspectDocument,
+    applyCommands,
+    restoreRevision,
+    exportStl,
+    subscribeDocument,
+    subscribeProject,
+  });
+});
+
+export const layer = Layer.effect(CadDocumentService, make);
