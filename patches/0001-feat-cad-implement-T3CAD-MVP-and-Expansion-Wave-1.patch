+
+export const CadCoordMm = Schema.Finite.check(
+  Schema.isBetween({ minimum: -CAD_MAX_DIMENSION_MM, maximum: CAD_MAX_DIMENSION_MM }),
+);
+export type CadCoordMm = typeof CadCoordMm.Type;
+
+export const CadFeatureName = TrimmedNonEmptyString.check(Schema.isMaxLength(80));
+
+export const CadSketchPlane = Schema.Literals(["xy", "xz", "yz"]);
+export type CadSketchPlane = typeof CadSketchPlane.Type;
+
+export const CadVec2 = Schema.Tuple([CadCoordMm, CadCoordMm]);
+export type CadVec2 = typeof CadVec2.Type;
+
+export const CadSketchRectangleFeature = Schema.Struct({
