+
+const UI_ACTOR: CadActor = {
+  kind: "user",
+  id: "workspace-user",
+  label: "CAD UI",
+};
+
+type CadSeedPreset = "mounting_plate" | "l_bracket" | "blank";
+type NewFeatureShape = "box" | "cylinder" | "l_polygon" | "hole_cut";
+
+let cadRequestSequence = 0;
+
+function makeRequestId(prefix: string): CadRequestId {
+  cadRequestSequence += 1;
+  const bytes = new Uint8Array(6);
+  globalThis.crypto.getRandomValues(bytes);
+  const randomHex = Array.from(bytes, (byte) => byte.toString(16).padStart(2, "0")).join("");
+  return CadRequestId.make(`${prefix}-${randomHex}-${cadRequestSequence}`);
+}
+
+function formatFailureMessage(failure: unknown, fallback: string): string {
+  if (failure instanceof Error) return failure.message;
+  if (
+    typeof failure === "object" &&
+    failure !== null &&
+    "message" in failure &&
+    typeof failure.message === "string"
+  ) {
+    return failure.message;
+  }
+  return fallback;
+}
+
+function featureParameters(
+  feature: CadFeature,
+): ReadonlyArray<{
+  readonly key: CadParameterName;
+  readonly label: string;
+  readonly value: number;
+}> {
+  switch (feature.kind) {
+    case "rectangle":
+      return [
+        { key: "width", label: "Width (mm)", value: feature.width },
+        { key: "height", label: "Height (mm)", value: feature.height },
+        { key: "x", label: "Origin U (mm)", value: feature.x },
+        { key: "y", label: "Origin V (mm)", value: feature.y },
+      ];
+    case "circle":
+      return [
+        { key: "radius", label: "Radius (mm)", value: feature.radius },
+        { key: "cx", label: "Center U (mm)", value: feature.cx },
+        { key: "cy", label: "Center V (mm)", value: feature.cy },
+      ];
+    case "polygon":
+      return [];
+    case "extrusion":
+      return [
+        { key: "depth", label: "Depth (mm)", value: feature.depth },
+        { key: "zOffset", label: "Normal Offset (mm)", value: feature.zOffset },
+      ];
+  }
+}
+
+function formatNumber(value: number): string {
+  if (!Number.isFinite(value)) return "-";
+  return Math.abs(value) >= 1000 ? value.toFixed(1) : value.toFixed(2);
+}
+
+function formatCompactDimension(value: number): string {
+  if (!Number.isFinite(value)) return "-";
+  const rounded = Math.round(value * 100) / 100;
+  return Number.isInteger(rounded) ? String(rounded) : rounded.toFixed(2);
+}
+
+function formatBoundsDimensions(snapshot: CadDocumentSnapshot): string {
+  const bounds = snapshot.report.boundsMm;
+  if (bounds === null) return "Empty";
+  const dx = bounds.max[0] - bounds.min[0];
+  const dy = bounds.max[1] - bounds.min[1];
+  const dz = bounds.max[2] - bounds.min[2];
+  return `${formatCompactDimension(dx)} × ${formatCompactDimension(dy)} × ${formatCompactDimension(dz)} mm`;
+}
+
+function triggerStlDownload(filename: string, stlAscii: string) {
+  const blob = new Blob([stlAscii], { type: "model/stl" });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = filename;
+  document.body.appendChild(link);
+  link.click();
+  document.body.removeChild(link);
+  window.setTimeout(() => URL.revokeObjectURL(url), 1_000);
